{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": [
      "!.claude/**/*",
      "!packages/corpus/quran/sources",
      "!repos/**/*"
    ]
  },
  "overrides": [
    {
      // Custom source conditions must precede the published types condition.
      "includes": [
        "packages/{compiler,contracts,corpus,publisher,utilities}/package.json"
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedPackageJson": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.{ts,tsx,mts,cts}",
        "**/test/**/*.{ts,tsx,mts,cts}"
      ],
      "javascript": {
        "globals": ["vi"]
      }
    }
  ],
  "linter": {
    "rules": {
      "complexity": {
        // Ultracite 8.2 turns this off for a deliberately floating promise.
        // Aksara starts every effect through Effect and floats none.
        "noVoid": "error"
      },
      "performance": {
        // Ultracite 8.2 turns this off for package entry points. Every Aksara
        // module is imported by its own path, so no module re-exports another.
        "noBarrelFile": "error",
        // Ultracite 8.2 turns this off for libraries that document `import * as`.
        // Aksara imports every module member by name.
        "noNamespaceImport": "error"
      },
      "style": {
        // Ultracite 8.2 allows one class per file. An Effect-native module
        // declares the Schema.TaggedError classes of its capability beside it,
        // so several classes in one module are the rule here, not a smell.
        "noExcessiveClassesPerFile": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@effect/vitest": {
                "importNames": ["vi"],
                "message": "Use the configured global vi for mocks. Import the remaining test APIs from @effect/vitest."
              }
            },
            "patterns": [
              {
                "group": ["vitest", "vitest/*", "!vitest/config"],
                "message": "Import test APIs from @effect/vitest. Keep vitest only as the required runner and config package."
              },
              {
                "group": ["./**", "../**"],
                "message": "Use a package alias instead of a relative module import."
              }
            ]
          }
        }
      }
    }
  }
}
