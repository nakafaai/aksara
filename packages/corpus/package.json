{
  "name": "@nakafa/aksara-corpus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#corpus/*": {
      "aksara-source": "./*.ts",
      "types": "./*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    "./articles/registry": {
      "aksara-source": "./articles/registry.ts",
      "types": "./dist/articles/registry.d.ts",
      "import": "./dist/articles/registry.js"
    },
    "./articles/source": {
      "aksara-source": "./articles/source.ts",
      "types": "./dist/articles/source.d.ts",
      "import": "./dist/articles/source.js"
    },
    "./editorial/requirements": {
      "aksara-source": "./editorial/requirements.ts",
      "types": "./dist/editorial/requirements.d.ts",
      "import": "./dist/editorial/requirements.js"
    },
    "./material/registry": {
      "aksara-source": "./material/registry.ts",
      "types": "./dist/material/registry.d.ts",
      "import": "./dist/material/registry.js"
    },
    "./material/source": {
      "aksara-source": "./material/source.ts",
      "types": "./dist/material/source.d.ts",
      "import": "./dist/material/source.js"
    },
    "./program/snapshot": {
      "aksara-source": "./program/snapshot.ts",
      "types": "./dist/program/snapshot.d.ts",
      "import": "./dist/program/snapshot.js"
    },
    "./quran/snapshot": {
      "aksara-source": "./quran/snapshot.ts",
      "types": "./dist/quran/snapshot.d.ts",
      "import": "./dist/quran/snapshot.js"
    },
    "./preview/selection": {
      "aksara-source": "./preview/selection.ts",
      "types": "./dist/preview/selection.d.ts",
      "import": "./dist/preview/selection.js"
    },
    "./preview/source": {
      "aksara-source": "./preview/source.ts",
      "types": "./dist/preview/source.d.ts",
      "import": "./dist/preview/source.js"
    },
    "./question-bank/content": {
      "aksara-source": "./question-bank/content.ts",
      "types": "./dist/question-bank/content.d.ts",
      "import": "./dist/question-bank/content.js"
    },
    "./question-bank/path": {
      "aksara-source": "./question-bank/path.ts",
      "types": "./dist/question-bank/path.d.ts",
      "import": "./dist/question-bank/path.js"
    },
    "./question-bank/source": {
      "aksara-source": "./question-bank/source.ts",
      "types": "./dist/question-bank/source.d.ts",
      "import": "./dist/question-bank/source.js"
    },
    "./team/source": {
      "aksara-source": "./team/source.ts",
      "types": "./dist/team/source.d.ts",
      "import": "./dist/team/source.js"
    },
    "./tryout/content": {
      "aksara-source": "./tryout/content.ts",
      "types": "./dist/tryout/content.d.ts",
      "import": "./dist/tryout/content.js"
    },
    "./tryout/registry": {
      "aksara-source": "./tryout/registry.ts",
      "types": "./dist/tryout/registry.d.ts",
      "import": "./dist/tryout/registry.js"
    }
  },
  "scripts": {
    "clean": "git clean -xdf dist coverage",
    "prebuild": "git clean -xdf dist",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@nakafa/aksara-contracts": "workspace:*",
    "@nakafa/aksara-utilities": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@nakafa/testing": "workspace:*",
    "@nakafa/typescript-config": "workspace:*",
    "@vitest/coverage-istanbul": "catalog:",
    "vitest": "catalog:"
  }
}
