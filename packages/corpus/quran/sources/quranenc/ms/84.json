{"result":[{"id":"5885","sura":"84","aya":"1","arabic_text":"\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0671\u0646\u0634\u064e\u0642\u0651\u064e\u062a\u06e1","translation":"Apabila langit terbelah,","footnotes":null},{"id":"5886","sura":"84","aya":"2","arabic_text":"\u0648\u064e\u0623\u064e\u0630\u0650\u0646\u064e\u062a\u06e1 \u0644\u0650\u0631\u064e\u0628\u0651\u0650\u0647\u064e\u0627 \u0648\u064e\u062d\u064f\u0642\u0651\u064e\u062a\u06e1","translation":"Serta mematuhi perintah Tuhannya, dan sudah semestinya ia patuh;","footnotes":null},{"id":"5887","sura":"84","aya":"3","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064f \u0645\u064f\u062f\u0651\u064e\u062a\u06e1","translation":"Dan apabila bumi diratakan,","footnotes":null},{"id":"5888","sura":"84","aya":"4","arabic_text":"\u0648\u064e\u0623\u064e\u0644\u06e1\u0642\u064e\u062a\u06e1 \u0645\u064e\u0627 \u0641\u0650\u064a\u0647\u064e\u0627 \u0648\u064e\u062a\u064e\u062e\u064e\u0644\u0651\u064e\u062a\u06e1","translation":"Serta mengeluarkan apa yang di dalamnya, dan menjadi kosong,","footnotes":null},{"id":"5889","sura":"84","aya":"5","arabic_text":"\u0648\u064e\u0623\u064e\u0630\u0650\u0646\u064e\u062a\u06e1 \u0644\u0650\u0631\u064e\u0628\u0651\u0650\u0647\u064e\u0627 \u0648\u064e\u062d\u064f\u0642\u0651\u064e\u062a\u06e1","translation":"Serta mematuhi perintah Tuhannya, dan sudah semestinya ia patuh; - (Maka pada saat itu tiap-tiap seorang akan mengetahui apa yang telah dilakukannya).","footnotes":null},{"id":"5890","sura":"84","aya":"6","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0625\u0650\u0646\u0651\u064e\u0643\u064e \u0643\u064e\u0627\u062f\u0650\u062d\u064c \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0643\u064e\u062f\u06e1\u062d\u0657\u0627 \u0641\u064e\u0645\u064f\u0644\u064e\u0670\u0642\u0650\u064a\u0647\u0650","translation":"Wahai manusia! Sesungguhnya engkau sentiasa berpenat-lelah (menjalankan keadaan hidupmu) dengan sedaya upayamu hinggalah (semasa engkau) kembali kepada Tuhanmu, kemudian engkau tetap menemui balasan apa yang engkau telah usahakan itu (tercatit semuanya).","footnotes":null},{"id":"5891","sura":"84","aya":"7","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064f\u0648\u062a\u0650\u064a\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u064e\u0647\u064f\u06e5 \u0628\u0650\u064a\u064e\u0645\u0650\u064a\u0646\u0650\u0647\u0650\u06e6","translation":"Kemudian sesiapa yang diberi menerima surat amalnya dengan tangan kanannya, -","footnotes":null},{"id":"5892","sura":"84","aya":"8","arabic_text":"\u0641\u064e\u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064f\u062d\u064e\u0627\u0633\u064e\u0628\u064f \u062d\u0650\u0633\u064e\u0627\u0628\u0657\u0627 \u064a\u064e\u0633\u0650\u064a\u0631\u0657\u0627","translation":"Maka ia akan dihisab dengan cara yang mudah dan ringan,","footnotes":null},{"id":"5893","sura":"84","aya":"9","arabic_text":"\u0648\u064e\u064a\u064e\u0646\u0642\u064e\u0644\u0650\u0628\u064f \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u06e6 \u0645\u064e\u0633\u06e1\u0631\u064f\u0648\u0631\u0657\u0627","translation":"Dan ia akan pergi kepada keluarganya (yang beriman) dengan sukacita.","footnotes":null},{"id":"5894","sura":"84","aya":"10","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064f\u0648\u062a\u0650\u064a\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u064e\u0647\u064f\u06e5 \u0648\u064e\u0631\u064e\u0627\u0653\u0621\u064e \u0638\u064e\u0647\u06e1\u0631\u0650\u0647\u0650\u06e6","translation":"Dan sesiapa yang diberi menerima surat amalnya (dengan tangan kiri), dari sebelah belakangnya,","footnotes":null},{"id":"5895","sura":"84","aya":"11","arabic_text":"\u0641\u064e\u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064e\u062f\u06e1\u0639\u064f\u0648\u0627\u0652 \u062b\u064f\u0628\u064f\u0648\u0631\u0657\u0627","translation":"Maka ia akan meraung menyebut-nyebut kebinasaannya,","footnotes":null},{"id":"5896","sura":"84","aya":"12","arabic_text":"\u0648\u064e\u064a\u064e\u0635\u06e1\u0644\u064e\u0649\u0670 \u0633\u064e\u0639\u0650\u064a\u0631\u064b\u0627","translation":"Dan ia akan menderita bakaran neraka yang marak menjulang.","footnotes":null},{"id":"5897","sura":"84","aya":"13","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0641\u0650\u064a\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u06e6 \u0645\u064e\u0633\u06e1\u0631\u064f\u0648\u0631\u064b\u0627","translation":"Sebenarnya ia semasa di dunia dahulu bersukaria dalam kalangan keluarganya (yang juga kufur ingkar)!","footnotes":null},{"id":"5898","sura":"84","aya":"14","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0638\u064e\u0646\u0651\u064e \u0623\u064e\u0646 \u0644\u0651\u064e\u0646 \u064a\u064e\u062d\u064f\u0648\u0631\u064e","translation":"Sesungguhnya ia menyangka bahawa ia tidak sekali-kali akan kembali (kepada Kami untuk menerima balasan)!","footnotes":null},{"id":"5899","sura":"84","aya":"15","arabic_text":"\u0628\u064e\u0644\u064e\u0649\u0670\u0653\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0628\u0650\u0647\u0650\u06e6 \u0628\u064e\u0635\u0650\u064a\u0631\u0657\u0627","translation":"(Sangkaannya itu tidak betul) bahkan ia tetap kembali! Sesungguhnya Tuhannya sentiasa Melihat dan Mengetahui keadaannya!","footnotes":null},{"id":"5900","sura":"84","aya":"16","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0671\u0644\u0634\u0651\u064e\u0641\u064e\u0642\u0650","translation":"Maka Aku bersumpah, demi mega;","footnotes":null},{"id":"5901","sura":"84","aya":"17","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0648\u064e\u0645\u064e\u0627 \u0648\u064e\u0633\u064e\u0642\u064e","translation":"Dan malam serta segala yang dihimpunkannya;","footnotes":null},{"id":"5902","sura":"84","aya":"18","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u0650 \u0625\u0650\u0630\u064e\u0627 \u0671\u062a\u0651\u064e\u0633\u064e\u0642\u064e","translation":"Dan bulan apabila (penuh cahayanya) menjadi purnama:","footnotes":null},{"id":"5903","sura":"84","aya":"19","arabic_text":"\u0644\u064e\u062a\u064e\u0631\u06e1\u0643\u064e\u0628\u064f\u0646\u0651\u064e \u0637\u064e\u0628\u064e\u0642\u064b\u0627 \u0639\u064e\u0646 \u0637\u064e\u0628\u064e\u0642\u0656","translation":"Sesungguhnya kamu tetap melalui beberapa keadaan yang bertingkat-tingkat baik buruknya, (sebelum kamu menemui Tuhan - menerima kesenangan dan kebahagiaan atau sebaliknya)","footnotes":null},{"id":"5904","sura":"84","aya":"20","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"Maka apakah alasan bagi mereka bersikap tidak mahu beriman?","footnotes":null},{"id":"5905","sura":"84","aya":"21","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u064f\u0631\u0650\u0626\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u064f \u0671\u0644\u06e1\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064f \u0644\u064e\u0627 \u064a\u064e\u0633\u06e1\u062c\u064f\u062f\u064f\u0648\u0646\u064e\u06e4\u06e9","translation":"Dan (apakah pula alasannya) apabila dibacakan Al-Quran kepada mereka, mereka tidak mahu taat dan sujud?","footnotes":null},{"id":"5906","sura":"84","aya":"22","arabic_text":"\u0628\u064e\u0644\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"(Tidak ada satu alasan pun) bahkan orang-orang yang kafir, semata-mata mendustakannya;","footnotes":null},{"id":"5907","sura":"84","aya":"23","arabic_text":"\u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0627 \u064a\u064f\u0648\u0639\u064f\u0648\u0646\u064e","translation":"Sedang Allah mengetahui apa yang mereka rahsiakan dalam hati.","footnotes":null},{"id":"5908","sura":"84","aya":"24","arabic_text":"\u0641\u064e\u0628\u064e\u0634\u0651\u0650\u0631\u06e1\u0647\u064f\u0645 \u0628\u0650\u0639\u064e\u0630\u064e\u0627\u0628\u064d \u0623\u064e\u0644\u0650\u064a\u0645\u064d","translation":"Maka khabarkanlah kepada mereka dengan azab yang tidak terperi sakitnya;","footnotes":null},{"id":"5909","sura":"84","aya":"25","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u064e\u0670\u062a\u0650 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u062c\u06e1\u0631\u064c \u063a\u064e\u064a\u06e1\u0631\u064f \u0645\u064e\u0645\u06e1\u0646\u064f\u0648\u0646\u0650\u06ed","translation":"Tetapi orang-orang yang beriman dan beramal soleh mereka beroleh pahala balasan yang tidak putus-putus.","footnotes":null}]}