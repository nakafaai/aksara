{"result":[{"id":"6107","sura":"96","aya":"1","arabic_text":"\u0671\u0642\u06e1\u0631\u064e\u0623\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062e\u064e\u0644\u064e\u0642\u064e","translation":"Bacalah (wahai Muhammad) dengan nama Tuhanmu yang menciptakan (sekalian makhluk),","footnotes":null},{"id":"6108","sura":"96","aya":"2","arabic_text":"\u062e\u064e\u0644\u064e\u0642\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0645\u0650\u0646\u06e1 \u0639\u064e\u0644\u064e\u0642\u064d","translation":"Ia menciptakan manusia dari sebuku darah beku;","footnotes":null},{"id":"6109","sura":"96","aya":"3","arabic_text":"\u0671\u0642\u06e1\u0631\u064e\u0623\u06e1 \u0648\u064e\u0631\u064e\u0628\u0651\u064f\u0643\u064e \u0671\u0644\u06e1\u0623\u064e\u0643\u06e1\u0631\u064e\u0645\u064f","translation":"Bacalah, dan Tuhanmu Yang Maha Pemurah, -","footnotes":null},{"id":"6110","sura":"96","aya":"4","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0639\u064e\u0644\u0651\u064e\u0645\u064e \u0628\u0650\u0671\u0644\u06e1\u0642\u064e\u0644\u064e\u0645\u0650","translation":"Yang mengajar manusia melalui pena dan tulisan, -","footnotes":null},{"id":"6111","sura":"96","aya":"5","arabic_text":"\u0639\u064e\u0644\u0651\u064e\u0645\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0645\u064e\u0627 \u0644\u064e\u0645\u06e1 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u06e1","translation":"Ia mengajarkan manusia apa yang tidak diketahuinya.","footnotes":null},{"id":"6112","sura":"96","aya":"6","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0644\u064e\u064a\u064e\u0637\u06e1\u063a\u064e\u0649\u0670\u0653","translation":"Ingatlah! Sesungguhnya jenis manusia tetap melampaui batas (yang sepatutnya atau yang sewajibnya),","footnotes":null},{"id":"6113","sura":"96","aya":"7","arabic_text":"\u0623\u064e\u0646 \u0631\u0651\u064e\u0621\u064e\u0627\u0647\u064f \u0671\u0633\u06e1\u062a\u064e\u063a\u06e1\u0646\u064e\u0649\u0670\u0653","translation":"Dengan sebab ia melihat dirinya sudah cukup apa yang dihajatinya.","footnotes":null},{"id":"6114","sura":"96","aya":"8","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u0631\u0651\u064f\u062c\u06e1\u0639\u064e\u0649\u0670\u0653","translation":"(Ingatlah) sesungguhnya kepada Tuhanmu lah tempat kembali (untuk menerima balasan).","footnotes":null},{"id":"6115","sura":"96","aya":"9","arabic_text":"\u0623\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064e\u0646\u06e1\u0647\u064e\u0649\u0670","translation":"Adakah engkau nampak (baiknya) orang yang melarang (dan menghalang) -","footnotes":null},{"id":"6116","sura":"96","aya":"10","arabic_text":"\u0639\u064e\u0628\u06e1\u062f\u064b\u0627 \u0625\u0650\u0630\u064e\u0627 \u0635\u064e\u0644\u0651\u064e\u0649\u0670\u0653","translation":"Seorang hamba Allah apabila ia mengerjakan sembahyang?","footnotes":null},{"id":"6117","sura":"96","aya":"11","arabic_text":"\u0623\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064e \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0647\u064f\u062f\u064e\u0649\u0670\u0653","translation":"Adakah engkau nampak (buruknya) jika ia berada di atas jalan yang betul? -","footnotes":null},{"id":"6118","sura":"96","aya":"12","arabic_text":"\u0623\u064e\u0648\u06e1 \u0623\u064e\u0645\u064e\u0631\u064e \u0628\u0650\u0671\u0644\u062a\u0651\u064e\u0642\u06e1\u0648\u064e\u0649\u0670\u0653","translation":"Atau ia menyuruh orang bertaqwa (jangan melakukan syirik)?","footnotes":null},{"id":"6119","sura":"96","aya":"13","arabic_text":"\u0623\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064e \u0625\u0650\u0646 \u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670\u0653","translation":"Adakah engkau nampak (terlepasnya dari azab) jika ia mendustakan (apa yang disampaikan oleh Nabi Muhammad kepadanya) serta ia berpaling ingkar?","footnotes":null},{"id":"6120","sura":"96","aya":"14","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645 \u0628\u0650\u0623\u064e\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u064a\u064e\u0631\u064e\u0649\u0670","translation":"Tidakkah ia mengetahui bahawa sesungguhnya Allah melihat (segala amal perbuatannya dan membalasnya)?","footnotes":null},{"id":"6121","sura":"96","aya":"15","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0644\u064e\u0626\u0650\u0646 \u0644\u0651\u064e\u0645\u06e1 \u064a\u064e\u0646\u062a\u064e\u0647\u0650 \u0644\u064e\u0646\u064e\u0633\u06e1\u0641\u064e\u0639\u064e\u06e2\u0627 \u0628\u0650\u0671\u0644\u0646\u0651\u064e\u0627\u0635\u0650\u064a\u064e\u0629\u0650","translation":"Jangan sekali-kali berlaku derhaka! Demi sesungguhnya jika ia tidak berhenti (dari perbuatannya yang buruk itu), nescaya Kami akan menyentap ubun-ubunnya (dan menyeretnya ke dalam neraka), -","footnotes":null},{"id":"6122","sura":"96","aya":"16","arabic_text":"\u0646\u064e\u0627\u0635\u0650\u064a\u064e\u0629\u0656 \u0643\u064e\u0670\u0630\u0650\u0628\u064e\u0629\u064d \u062e\u064e\u0627\u0637\u0650\u0626\u064e\u0629\u0656","translation":"Ubun-ubun (orang) yang berdusta, yang bersalah.","footnotes":null},{"id":"6123","sura":"96","aya":"17","arabic_text":"\u0641\u064e\u0644\u06e1\u064a\u064e\u062f\u06e1\u0639\u064f \u0646\u064e\u0627\u062f\u0650\u064a\u064e\u0647\u064f\u06e5","translation":"Kemudian biarlah ia memanggil kumpulannya (untuk menyelamatkannya),","footnotes":null},{"id":"6124","sura":"96","aya":"18","arabic_text":"\u0633\u064e\u0646\u064e\u062f\u06e1\u0639\u064f \u0671\u0644\u0632\u0651\u064e\u0628\u064e\u0627\u0646\u0650\u064a\u064e\u0629\u064e","translation":"Kami pula akan memanggil malaikat Zabaniyah (untuk menyeksanya)!","footnotes":null},{"id":"6125","sura":"96","aya":"19","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0644\u064e\u0627 \u062a\u064f\u0637\u0650\u0639\u06e1\u0647\u064f \u0648\u064e\u0671\u0633\u06e1\u062c\u064f\u062f\u06e1\u06e4 \u0648\u064e\u0671\u0642\u06e1\u062a\u064e\u0631\u0650\u0628\u06e9","translation":"Ingatlah! Janganlah engkau (wahai Muhammad) menurut kehendaknya, dan (sebaliknya) sujudlah dan dampingkanlah dirimu kepada Allah (dengan taat dan beramal soleh)!","footnotes":null}]}