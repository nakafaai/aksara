{"result":[{"id":"4902","sura":"55","aya":"1","arabic_text":"\u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u064f","translation":"(Tuhan) Yang Maha Pemurah serta melimpah-limpah rahmatNya.","footnotes":null},{"id":"4903","sura":"55","aya":"2","arabic_text":"\u0639\u064e\u0644\u0651\u064e\u0645\u064e \u0671\u0644\u06e1\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064e","translation":"Dia lah yang telah mengajarkan Al-Quran.","footnotes":null},{"id":"4904","sura":"55","aya":"3","arabic_text":"\u062e\u064e\u0644\u064e\u0642\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e","translation":"Dia lah yang telah menciptakan manusia; -","footnotes":null},{"id":"4905","sura":"55","aya":"4","arabic_text":"\u0639\u064e\u0644\u0651\u064e\u0645\u064e\u0647\u064f \u0671\u0644\u06e1\u0628\u064e\u064a\u064e\u0627\u0646\u064e","translation":"Dia lah yang telah membolehkan manusia (bertutur) memberi dan menerima kenyataan.","footnotes":null},{"id":"4906","sura":"55","aya":"5","arabic_text":"\u0671\u0644\u0634\u0651\u064e\u0645\u06e1\u0633\u064f \u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u064f \u0628\u0650\u062d\u064f\u0633\u06e1\u0628\u064e\u0627\u0646\u0656","translation":"Matahari dan bulan beredar dengan peraturan dan hitungan yang tertentu;","footnotes":null},{"id":"4907","sura":"55","aya":"6","arabic_text":"\u0648\u064e\u0671\u0644\u0646\u0651\u064e\u062c\u06e1\u0645\u064f \u0648\u064e\u0671\u0644\u0634\u0651\u064e\u062c\u064e\u0631\u064f \u064a\u064e\u0633\u06e1\u062c\u064f\u062f\u064e\u0627\u0646\u0650","translation":"Dan tumbuh-tumbuhan yang melata serta pohon-pohon kayu-kayan, masing-masing tunduk menurut peraturanNya.","footnotes":null},{"id":"4908","sura":"55","aya":"7","arabic_text":"\u0648\u064e\u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064e \u0631\u064e\u0641\u064e\u0639\u064e\u0647\u064e\u0627 \u0648\u064e\u0648\u064e\u0636\u064e\u0639\u064e \u0671\u0644\u06e1\u0645\u0650\u064a\u0632\u064e\u0627\u0646\u064e","translation":"Dan langit dijadikannya (bumbung) tinggi, serta Ia mengadakan undang-undang dan peraturan neraca keadilan,","footnotes":null},{"id":"4909","sura":"55","aya":"8","arabic_text":"\u0623\u064e\u0644\u0651\u064e\u0627 \u062a\u064e\u0637\u06e1\u063a\u064e\u0648\u06e1\u0627\u0652 \u0641\u0650\u064a \u0671\u0644\u06e1\u0645\u0650\u064a\u0632\u064e\u0627\u0646\u0650","translation":"Supaya kamu tidak melampaui batas dalam menjalankan keadilan;","footnotes":null},{"id":"4910","sura":"55","aya":"9","arabic_text":"\u0648\u064e\u0623\u064e\u0642\u0650\u064a\u0645\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0648\u064e\u0632\u06e1\u0646\u064e \u0628\u0650\u0671\u0644\u06e1\u0642\u0650\u0633\u06e1\u0637\u0650 \u0648\u064e\u0644\u064e\u0627 \u062a\u064f\u062e\u06e1\u0633\u0650\u0631\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0645\u0650\u064a\u0632\u064e\u0627\u0646\u064e","translation":"Dan betulkanlah cara menimbang itu dengan adil, serta janganlah kamu mengurangi barang yang ditimbang.","footnotes":null},{"id":"4911","sura":"55","aya":"10","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0648\u064e\u0636\u064e\u0639\u064e\u0647\u064e\u0627 \u0644\u0650\u0644\u06e1\u0623\u064e\u0646\u064e\u0627\u0645\u0650","translation":"Dan bumi pula dijadikannya rata untuk kegunaan manusia dan makhluk-makhlukNya yang lain:","footnotes":null},{"id":"4912","sura":"55","aya":"11","arabic_text":"\u0641\u0650\u064a\u0647\u064e\u0627 \u0641\u064e\u0670\u0643\u0650\u0647\u064e\u0629\u065e \u0648\u064e\u0671\u0644\u0646\u0651\u064e\u062e\u06e1\u0644\u064f \u0630\u064e\u0627\u062a\u064f \u0671\u0644\u06e1\u0623\u064e\u0643\u06e1\u0645\u064e\u0627\u0645\u0650","translation":"Terdapat padanya berbagai jenis buah-buahan dan pohon-pohon kurma yang ada kelopak-kelopak mayang;","footnotes":null},{"id":"4913","sura":"55","aya":"12","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u062d\u064e\u0628\u0651\u064f \u0630\u064f\u0648 \u0671\u0644\u06e1\u0639\u064e\u0635\u06e1\u0641\u0650 \u0648\u064e\u0671\u0644\u0631\u0651\u064e\u064a\u06e1\u062d\u064e\u0627\u0646\u064f","translation":"Demikian juga terdapat biji-bijian yang ada jerami serta daun, dan terdapat lagi bunga-bungaan yang harum;","footnotes":null},{"id":"4914","sura":"55","aya":"13","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan (wahai umat manusia dan jin)?","footnotes":null},{"id":"4915","sura":"55","aya":"14","arabic_text":"\u062e\u064e\u0644\u064e\u0642\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0645\u0650\u0646 \u0635\u064e\u0644\u06e1\u0635\u064e\u0670\u0644\u0656 \u0643\u064e\u0671\u0644\u06e1\u0641\u064e\u062e\u0651\u064e\u0627\u0631\u0650","translation":"Ia menciptakan manusia (lembaga Adam) dari tanah liat kering seperti tembikar,","footnotes":null},{"id":"4916","sura":"55","aya":"15","arabic_text":"\u0648\u064e\u062e\u064e\u0644\u064e\u0642\u064e \u0671\u0644\u06e1\u062c\u064e\u0627\u0653\u0646\u0651\u064e \u0645\u0650\u0646 \u0645\u0651\u064e\u0627\u0631\u0650\u062c\u0656 \u0645\u0651\u0650\u0646 \u0646\u0651\u064e\u0627\u0631\u0656","translation":"Dan Ia telah menciptakan jin dari lidah api yang menjulang-julang;","footnotes":null},{"id":"4917","sura":"55","aya":"16","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4918","sura":"55","aya":"17","arabic_text":"\u0631\u064e\u0628\u0651\u064f \u0671\u0644\u06e1\u0645\u064e\u0634\u06e1\u0631\u0650\u0642\u064e\u064a\u06e1\u0646\u0650 \u0648\u064e\u0631\u064e\u0628\u0651\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0631\u0650\u0628\u064e\u064a\u06e1\u0646\u0650","translation":"(Dia lah) Tuhan yang mentadbirkan dua timur, dan Tuhan yang mentadbirkan dua barat.","footnotes":null},{"id":"4919","sura":"55","aya":"18","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4920","sura":"55","aya":"19","arabic_text":"\u0645\u064e\u0631\u064e\u062c\u064e \u0671\u0644\u06e1\u0628\u064e\u062d\u06e1\u0631\u064e\u064a\u06e1\u0646\u0650 \u064a\u064e\u0644\u06e1\u062a\u064e\u0642\u0650\u064a\u064e\u0627\u0646\u0650","translation":"Ia biarkan air dua laut (yang masin dan yang tawar) mengalir, sedang keduanya pula bertemu;","footnotes":null},{"id":"4921","sura":"55","aya":"20","arabic_text":"\u0628\u064e\u064a\u06e1\u0646\u064e\u0647\u064f\u0645\u064e\u0627 \u0628\u064e\u0631\u06e1\u0632\u064e\u062e\u065e \u0644\u0651\u064e\u0627 \u064a\u064e\u0628\u06e1\u063a\u0650\u064a\u064e\u0627\u0646\u0650","translation":"Di antara keduanya ada penyekat yang memisahkannya, masing-masing tidak melampaui sempadannya;","footnotes":null},{"id":"4922","sura":"55","aya":"21","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4923","sura":"55","aya":"22","arabic_text":"\u064a\u064e\u062e\u06e1\u0631\u064f\u062c\u064f \u0645\u0650\u0646\u06e1\u0647\u064f\u0645\u064e\u0627 \u0671\u0644\u0644\u0651\u064f\u0624\u06e1\u0644\u064f\u0624\u064f \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u0631\u06e1\u062c\u064e\u0627\u0646\u064f","translation":"Dari kedua laut itu, keluar mutiara dan marjan;","footnotes":null},{"id":"4924","sura":"55","aya":"23","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4925","sura":"55","aya":"24","arabic_text":"\u0648\u064e\u0644\u064e\u0647\u064f \u0671\u0644\u06e1\u062c\u064e\u0648\u064e\u0627\u0631\u0650 \u0671\u0644\u06e1\u0645\u064f\u0646\u0634\u064e\u0640\u0654\u064e\u0627\u062a\u064f \u0641\u0650\u064a \u0671\u0644\u06e1\u0628\u064e\u062d\u06e1\u0631\u0650 \u0643\u064e\u0671\u0644\u06e1\u0623\u064e\u0639\u06e1\u0644\u064e\u0670\u0645\u0650","translation":"Dan Dia lah yang menguasai kapal-kapal yang belayar di laut, yang kembang tinggi layarnya seperti gunung-ganang;","footnotes":null},{"id":"4926","sura":"55","aya":"25","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4927","sura":"55","aya":"26","arabic_text":"\u0643\u064f\u0644\u0651\u064f \u0645\u064e\u0646\u06e1 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u064e\u0627 \u0641\u064e\u0627\u0646\u0656","translation":"Segala yang ada di muka bumi itu akan binasa:","footnotes":null},{"id":"4928","sura":"55","aya":"27","arabic_text":"\u0648\u064e\u064a\u064e\u0628\u06e1\u0642\u064e\u0649\u0670 \u0648\u064e\u062c\u06e1\u0647\u064f \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0630\u064f\u0648 \u0671\u0644\u06e1\u062c\u064e\u0644\u064e\u0670\u0644\u0650 \u0648\u064e\u0671\u0644\u06e1\u0625\u0650\u0643\u06e1\u0631\u064e\u0627\u0645\u0650","translation":"Dan akan kekalah Zat Tuhanmu yang mempunyai Kebesaran dan Kemuliaan:","footnotes":null},{"id":"4929","sura":"55","aya":"28","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4930","sura":"55","aya":"29","arabic_text":"\u064a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f\u0647\u064f\u06e5 \u0645\u064e\u0646 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650\u06da \u0643\u064f\u0644\u0651\u064e \u064a\u064e\u0648\u06e1\u0645\u064d \u0647\u064f\u0648\u064e \u0641\u0650\u064a \u0634\u064e\u0623\u06e1\u0646\u0656","translation":"Sekalian makhluk yang ada di langit dan di bumi sentiasa berhajat dan memohon kepadaNya. Tiap-tiap masa Ia di dalam urusan (mencipta dan mentadbirkan makhluk-makhlukNya)!","footnotes":null},{"id":"4931","sura":"55","aya":"30","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan)?","footnotes":null},{"id":"4932","sura":"55","aya":"31","arabic_text":"\u0633\u064e\u0646\u064e\u0641\u06e1\u0631\u064f\u063a\u064f \u0644\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0647\u064e \u0671\u0644\u062b\u0651\u064e\u0642\u064e\u0644\u064e\u0627\u0646\u0650","translation":"Kami hanya akan menguruskan hitungan dan balasan amal kamu sahaja (pada hari kiamat,) wahai manusia dan jin!","footnotes":null},{"id":"4933","sura":"55","aya":"32","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4934","sura":"55","aya":"33","arabic_text":"\u064a\u064e\u0670\u0645\u064e\u0639\u06e1\u0634\u064e\u0631\u064e \u0671\u0644\u06e1\u062c\u0650\u0646\u0651\u0650 \u0648\u064e\u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u0650 \u0625\u0650\u0646\u0650 \u0671\u0633\u06e1\u062a\u064e\u0637\u064e\u0639\u06e1\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646 \u062a\u064e\u0646\u0641\u064f\u0630\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u06e1 \u0623\u064e\u0642\u06e1\u0637\u064e\u0627\u0631\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0641\u064e\u0671\u0646\u0641\u064f\u0630\u064f\u0648\u0627\u0652\u06da \u0644\u064e\u0627 \u062a\u064e\u0646\u0641\u064f\u0630\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0628\u0650\u0633\u064f\u0644\u06e1\u0637\u064e\u0670\u0646\u0656","translation":"Wahai sekalian jin dan manusia! Kalau kamu dapat menembus keluar dari kawasan-kawasan langit dan bumi (untuk melarikan diri dari kekuasaan dan balasan Kami), maka cubalah kamu menembus keluar. Kamu tidak akan menembus keluar melainkan dengan satu kekuasaan (yang mengatasi kekuasaan Kami; masakan dapat)!","footnotes":null},{"id":"4935","sura":"55","aya":"34","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4936","sura":"55","aya":"35","arabic_text":"\u064a\u064f\u0631\u06e1\u0633\u064e\u0644\u064f \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u064e\u0627 \u0634\u064f\u0648\u064e\u0627\u0638\u065e \u0645\u0651\u0650\u0646 \u0646\u0651\u064e\u0627\u0631\u0656 \u0648\u064e\u0646\u064f\u062d\u064e\u0627\u0633\u065e \u0641\u064e\u0644\u064e\u0627 \u062a\u064e\u0646\u062a\u064e\u0635\u0650\u0631\u064e\u0627\u0646\u0650","translation":"Kamu (wahai golongan yang kufur ingkar dari kalangan jin dan manusia) akan ditimpakan dengan api yang menjulang-julang dan leburan tembaga cair (yang membakar); dengan yang demikian, kamu tidak akan dapat mempertahankan diri (dari azab seksa itu);","footnotes":null},{"id":"4937","sura":"55","aya":"36","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4938","sura":"55","aya":"37","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0646\u0634\u064e\u0642\u0651\u064e\u062a\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0641\u064e\u0643\u064e\u0627\u0646\u064e\u062a\u06e1 \u0648\u064e\u0631\u06e1\u062f\u064e\u0629\u0657 \u0643\u064e\u0671\u0644\u062f\u0651\u0650\u0647\u064e\u0627\u0646\u0650","translation":"Selain itu (sungguh ngeri) ketika langit pecah-belah lalu menjadilah ia merah mawar, berkilat seperti minyak;","footnotes":null},{"id":"4939","sura":"55","aya":"38","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4940","sura":"55","aya":"39","arabic_text":"\u0641\u064e\u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u064e\u0627 \u064a\u064f\u0633\u06e1\u0640\u0654\u064e\u0644\u064f \u0639\u064e\u0646 \u0630\u064e\u0646\u06e2\u0628\u0650\u0647\u0650\u06e6\u0653 \u0625\u0650\u0646\u0633\u065e \u0648\u064e\u0644\u064e\u0627 \u062c\u064e\u0627\u0653\u0646\u0651\u065e","translation":"Pada masa itu tiada sesiapapun, sama ada manusia atau jin, yang akan ditanya tentang dosanya (kerana masing-masing dapat dikenal menurut keadaannya);","footnotes":null},{"id":"4941","sura":"55","aya":"40","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4942","sura":"55","aya":"41","arabic_text":"\u064a\u064f\u0639\u06e1\u0631\u064e\u0641\u064f \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e \u0628\u0650\u0633\u0650\u064a\u0645\u064e\u0670\u0647\u064f\u0645\u06e1 \u0641\u064e\u064a\u064f\u0624\u06e1\u062e\u064e\u0630\u064f \u0628\u0650\u0671\u0644\u0646\u0651\u064e\u0648\u064e\u0670\u0635\u0650\u064a \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0642\u06e1\u062f\u064e\u0627\u0645\u0650","translation":"Orang-orang yang berdosa dapat dikenal dari tanda-tandanya, lalu dipegang dari atas kepala dan kakinya (serta diseret ke neraka);","footnotes":null},{"id":"4943","sura":"55","aya":"42","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4944","sura":"55","aya":"43","arabic_text":"\u0647\u064e\u0670\u0630\u0650\u0647\u0650\u06e6 \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064f \u0671\u0644\u0651\u064e\u062a\u0650\u064a \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u0647\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e","translation":"(Lalu dikatakan kepada mereka): \u201cInilah neraka Jahannam yang selalu orang-orang yang berdosa mendustakannya\u201d.","footnotes":null},{"id":"4945","sura":"55","aya":"44","arabic_text":"\u064a\u064e\u0637\u064f\u0648\u0641\u064f\u0648\u0646\u064e \u0628\u064e\u064a\u06e1\u0646\u064e\u0647\u064e\u0627 \u0648\u064e\u0628\u064e\u064a\u06e1\u0646\u064e \u062d\u064e\u0645\u0650\u064a\u0645\u064d \u0621\u064e\u0627\u0646\u0656","translation":"Mereka (terus diseksa) berulang-ulang di antara api neraka dengan air yang menggelegak yang cukup masak panasnya!","footnotes":null},{"id":"4946","sura":"55","aya":"45","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4947","sura":"55","aya":"46","arabic_text":"\u0648\u064e\u0644\u0650\u0645\u064e\u0646\u06e1 \u062e\u064e\u0627\u0641\u064e \u0645\u064e\u0642\u064e\u0627\u0645\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u062c\u064e\u0646\u0651\u064e\u062a\u064e\u0627\u0646\u0650","translation":"Dan orang yang takut akan keadaan dirinya di mahkamah Tuhannya (untuk dihitung amalnya), disediakan baginya dua Syurga, -","footnotes":null},{"id":"4948","sura":"55","aya":"47","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4949","sura":"55","aya":"48","arabic_text":"\u0630\u064e\u0648\u064e\u0627\u062a\u064e\u0627\u0653 \u0623\u064e\u0641\u06e1\u0646\u064e\u0627\u0646\u0656","translation":"(Dua Syurga) yang ada berjenis-jenis pohon dan buah-buahan; -","footnotes":null},{"id":"4950","sura":"55","aya":"49","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4951","sura":"55","aya":"50","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0645\u064e\u0627 \u0639\u064e\u064a\u06e1\u0646\u064e\u0627\u0646\u0650 \u062a\u064e\u062c\u06e1\u0631\u0650\u064a\u064e\u0627\u0646\u0650","translation":"Pada kedua-dua Syurga itu terdapat dua matair yang mengalir; -","footnotes":null},{"id":"4952","sura":"55","aya":"51","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan.","footnotes":null},{"id":"4953","sura":"55","aya":"52","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0645\u064e\u0627 \u0645\u0650\u0646 \u0643\u064f\u0644\u0651\u0650 \u0641\u064e\u0670\u0643\u0650\u0647\u064e\u0629\u0656 \u0632\u064e\u0648\u06e1\u062c\u064e\u0627\u0646\u0650","translation":"Pada kedua Syurga itu terdapat dua macam dari tiap-tiap jenis buah-buahan (yang biasa dan yang luar biasa).","footnotes":null},{"id":"4954","sura":"55","aya":"53","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4955","sura":"55","aya":"54","arabic_text":"\u0645\u064f\u062a\u0651\u064e\u0643\u0650\u0640\u0654\u0650\u064a\u0646\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0641\u064f\u0631\u064f\u0634\u0650\u06ed \u0628\u064e\u0637\u064e\u0627\u0653\u0626\u0650\u0646\u064f\u0647\u064e\u0627 \u0645\u0650\u0646\u06e1 \u0625\u0650\u0633\u06e1\u062a\u064e\u0628\u06e1\u0631\u064e\u0642\u0656\u06da \u0648\u064e\u062c\u064e\u0646\u064e\u0649 \u0671\u0644\u06e1\u062c\u064e\u0646\u0651\u064e\u062a\u064e\u064a\u06e1\u0646\u0650 \u062f\u064e\u0627\u0646\u0656","translation":"Mereka (bersenang-senang di tempat masing-masing dalam Syurga itu dengan) berbaring di atas hamparan-hamparan, yang lapisan-lapisan sebelah dalamnya - dari sutera tebal yang bersulam; dan buah-buahan kedua-dua Syurga itu dekat (kepada mereka) untuk dipetik.","footnotes":null},{"id":"4956","sura":"55","aya":"55","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4957","sura":"55","aya":"56","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0646\u0651\u064e \u0642\u064e\u0670\u0635\u0650\u0631\u064e\u0670\u062a\u064f \u0671\u0644\u0637\u0651\u064e\u0631\u06e1\u0641\u0650 \u0644\u064e\u0645\u06e1 \u064a\u064e\u0637\u06e1\u0645\u0650\u062b\u06e1\u0647\u064f\u0646\u0651\u064e \u0625\u0650\u0646\u0633\u065e \u0642\u064e\u0628\u06e1\u0644\u064e\u0647\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627 \u062c\u064e\u0627\u0653\u0646\u0651\u065e","translation":"Di dalam Syurga-syurga itu terdapat bidadari-bidadari yang pandangannya tertumpu (kepada mereka semata-mata), yang tidak pernah disentuh sebelum mereka oleh manusia dan jin;","footnotes":null},{"id":"4958","sura":"55","aya":"57","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4959","sura":"55","aya":"58","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0646\u0651\u064e \u0671\u0644\u06e1\u064a\u064e\u0627\u0642\u064f\u0648\u062a\u064f \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u0631\u06e1\u062c\u064e\u0627\u0646\u064f","translation":"Bidadari-bidadari itu (cantik berseri) seperti permata delima dan marjan.","footnotes":null},{"id":"4960","sura":"55","aya":"59","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4961","sura":"55","aya":"60","arabic_text":"\u0647\u064e\u0644\u06e1 \u062c\u064e\u0632\u064e\u0627\u0653\u0621\u064f \u0671\u0644\u06e1\u0625\u0650\u062d\u06e1\u0633\u064e\u0670\u0646\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u0625\u0650\u062d\u06e1\u0633\u064e\u0670\u0646\u064f","translation":"Bukankah tidak ada balasan bagi amal yang baik - melainkan balasan yang baik juga?","footnotes":null},{"id":"4962","sura":"55","aya":"61","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4963","sura":"55","aya":"62","arabic_text":"\u0648\u064e\u0645\u0650\u0646 \u062f\u064f\u0648\u0646\u0650\u0647\u0650\u0645\u064e\u0627 \u062c\u064e\u0646\u0651\u064e\u062a\u064e\u0627\u0646\u0650","translation":"Dan selain dari dua Syurga itu, dua Syurga lagi (untuk menjadi balasan bagi golongan peringkat yang kedua);","footnotes":null},{"id":"4964","sura":"55","aya":"63","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4965","sura":"55","aya":"64","arabic_text":"\u0645\u064f\u062f\u06e1\u0647\u064e\u0627\u0653\u0645\u0651\u064e\u062a\u064e\u0627\u0646\u0650","translation":"Kedua-duanya menghijau subur tanamannya;","footnotes":null},{"id":"4966","sura":"55","aya":"65","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4967","sura":"55","aya":"66","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0645\u064e\u0627 \u0639\u064e\u064a\u06e1\u0646\u064e\u0627\u0646\u0650 \u0646\u064e\u0636\u0651\u064e\u0627\u062e\u064e\u062a\u064e\u0627\u0646\u0650","translation":"Dalam kedua-dua Syurga itu terdapat dua matair yang terus menerus memancutkan airnya:","footnotes":null},{"id":"4968","sura":"55","aya":"67","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4969","sura":"55","aya":"68","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0645\u064e\u0627 \u0641\u064e\u0670\u0643\u0650\u0647\u064e\u0629\u065e \u0648\u064e\u0646\u064e\u062e\u06e1\u0644\u065e \u0648\u064e\u0631\u064f\u0645\u0651\u064e\u0627\u0646\u065e","translation":"Pada keduanya juga terdapat buah-buahan, serta pohon-pohon kurma dan delima,","footnotes":null},{"id":"4970","sura":"55","aya":"69","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4971","sura":"55","aya":"70","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0646\u0651\u064e \u062e\u064e\u064a\u06e1\u0631\u064e\u0670\u062a\u064c \u062d\u0650\u0633\u064e\u0627\u0646\u065e","translation":"Dalam kedua-dua Syurga itu juga terdapat (teman-teman) yang baik akhlaknya, lagi cantik parasnya;","footnotes":null},{"id":"4972","sura":"55","aya":"71","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4973","sura":"55","aya":"72","arabic_text":"\u062d\u064f\u0648\u0631\u065e \u0645\u0651\u064e\u0642\u06e1\u0635\u064f\u0648\u0631\u064e\u0670\u062a\u065e \u0641\u0650\u064a \u0671\u0644\u06e1\u062e\u0650\u064a\u064e\u0627\u0645\u0650","translation":"Ia itu bidadari-bidadari, yang hanya tinggal tetap di tempat tinggal masing-masing;","footnotes":null},{"id":"4974","sura":"55","aya":"73","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4975","sura":"55","aya":"74","arabic_text":"\u0644\u064e\u0645\u06e1 \u064a\u064e\u0637\u06e1\u0645\u0650\u062b\u06e1\u0647\u064f\u0646\u0651\u064e \u0625\u0650\u0646\u0633\u065e \u0642\u064e\u0628\u06e1\u0644\u064e\u0647\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627 \u062c\u064e\u0627\u0653\u0646\u0651\u065e","translation":"(Bidadari-bidadari itu) tidak pernah disentuh sebelum mereka oleh manusia dan tidak juga oleh jin;","footnotes":null},{"id":"4976","sura":"55","aya":"75","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4977","sura":"55","aya":"76","arabic_text":"\u0645\u064f\u062a\u0651\u064e\u0643\u0650\u0640\u0654\u0650\u064a\u0646\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0631\u064e\u0641\u06e1\u0631\u064e\u0641\u064d \u062e\u064f\u0636\u06e1\u0631\u0656 \u0648\u064e\u0639\u064e\u0628\u06e1\u0642\u064e\u0631\u0650\u064a\u0651\u064d \u062d\u0650\u0633\u064e\u0627\u0646\u0656","translation":"Penduduk Syurga itu (bersenang-senang di dalamnya dengan) berbaring di atas (bantal-bantal dan) cadar-cadar yang hijau warnanya serta permaidani-permaidani yang sangat indah.","footnotes":null},{"id":"4978","sura":"55","aya":"77","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka yang mana satu di antara nikmat-nikmat Tuhan kamu, yang kamu hendak dustakan?","footnotes":null},{"id":"4979","sura":"55","aya":"78","arabic_text":"\u062a\u064e\u0628\u064e\u0670\u0631\u064e\u0643\u064e \u0671\u0633\u06e1\u0645\u064f \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0630\u0650\u064a \u0671\u0644\u06e1\u062c\u064e\u0644\u064e\u0670\u0644\u0650 \u0648\u064e\u0671\u0644\u06e1\u0625\u0650\u0643\u06e1\u0631\u064e\u0627\u0645\u0650","translation":"Maha Sucilah nama Tuhanmu yang mempunyai Kebesaran dan Kemuliaan.","footnotes":null}]}