{"result":[{"id":"5830","sura":"82","aya":"1","arabic_text":"\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0671\u0646\u0641\u064e\u0637\u064e\u0631\u064e\u062a\u06e1","translation":"Apabila langit terbelah;","footnotes":null},{"id":"5831","sura":"82","aya":"2","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u0643\u064e\u0648\u064e\u0627\u0643\u0650\u0628\u064f \u0671\u0646\u062a\u064e\u062b\u064e\u0631\u064e\u062a\u06e1","translation":"Dan apabila bintang-bintang gugur bertaburan;","footnotes":null},{"id":"5832","sura":"82","aya":"3","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u0628\u0650\u062d\u064e\u0627\u0631\u064f \u0641\u064f\u062c\u0651\u0650\u0631\u064e\u062a\u06e1","translation":"Dan apabila lautan pecah bercampur-baur;","footnotes":null},{"id":"5833","sura":"82","aya":"4","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u0642\u064f\u0628\u064f\u0648\u0631\u064f \u0628\u064f\u0639\u06e1\u062b\u0650\u0631\u064e\u062a\u06e1","translation":"Dan apabila kubur-kubur dibongkarkan, -","footnotes":null},{"id":"5834","sura":"82","aya":"5","arabic_text":"\u0639\u064e\u0644\u0650\u0645\u064e\u062a\u06e1 \u0646\u064e\u0641\u06e1\u0633\u065e \u0645\u0651\u064e\u0627 \u0642\u064e\u062f\u0651\u064e\u0645\u064e\u062a\u06e1 \u0648\u064e\u0623\u064e\u062e\u0651\u064e\u0631\u064e\u062a\u06e1","translation":"(Setelah semuanya itu berlaku), tiap-tiap orang akan mengetahui apa yang telah dikerjakan dan ditinggalkannya.","footnotes":null},{"id":"5835","sura":"82","aya":"6","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0645\u064e\u0627 \u063a\u064e\u0631\u0651\u064e\u0643\u064e \u0628\u0650\u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0643\u064e\u0631\u0650\u064a\u0645\u0650","translation":"Wahai manusia! Apakah yang memperdayakanmu - (berlaku derhaka) kepada Tuhanmu yang Maha Pemurah? -","footnotes":null},{"id":"5836","sura":"82","aya":"7","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062e\u064e\u0644\u064e\u0642\u064e\u0643\u064e \u0641\u064e\u0633\u064e\u0648\u0651\u064e\u0649\u0670\u0643\u064e \u0641\u064e\u0639\u064e\u062f\u064e\u0644\u064e\u0643\u064e","translation":"Tuhan yang telah mencipta dan mengatur kejadianmu, lalu menjadikan anggotamu sesuai (dengan tujuan yang kerananya anggota itu diadakan), serta menjadikan (binaan tubuh badanmu) sama padan dengan kekuatannya;","footnotes":null},{"id":"5837","sura":"82","aya":"8","arabic_text":"\u0641\u0650\u064a\u0653 \u0623\u064e\u064a\u0651\u0650 \u0635\u064f\u0648\u0631\u064e\u0629\u0656 \u0645\u0651\u064e\u0627 \u0634\u064e\u0627\u0653\u0621\u064e \u0631\u064e\u0643\u0651\u064e\u0628\u064e\u0643\u064e","translation":"Dalam bentuk dan rupa apa sahaja yang dikehendakiNya, Ia menyusun kejadianmu.","footnotes":null},{"id":"5838","sura":"82","aya":"9","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0628\u064e\u0644\u06e1 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"Sebenarnya tidak ada yang memperdayakan kamu (hai golongan yang ingkar)! Bahkan kamu sendiri tidak percayakan adanya hari pembalasan.","footnotes":null},{"id":"5839","sura":"82","aya":"10","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u06e1 \u0644\u064e\u062d\u064e\u0670\u0641\u0650\u0638\u0650\u064a\u0646\u064e","translation":"Padahal sesungguhnya, ada malaikat-malaikat yang menjaga dan mengawas segala bawaan kamu,","footnotes":null},{"id":"5840","sura":"82","aya":"11","arabic_text":"\u0643\u0650\u0631\u064e\u0627\u0645\u0657\u0627 \u0643\u064e\u0670\u062a\u0650\u0628\u0650\u064a\u0646\u064e","translation":"(Mereka adalah makhluk) yang mulia (di sisi Allah), lagi ditugaskan menulis (amal-amal kamu);","footnotes":null},{"id":"5841","sura":"82","aya":"12","arabic_text":"\u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0645\u064e\u0627 \u062a\u064e\u0641\u06e1\u0639\u064e\u0644\u064f\u0648\u0646\u064e","translation":"Mereka mengetahui apa yang kamu lakukan.","footnotes":null},{"id":"5842","sura":"82","aya":"13","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0623\u064e\u0628\u06e1\u0631\u064e\u0627\u0631\u064e \u0644\u064e\u0641\u0650\u064a \u0646\u064e\u0639\u0650\u064a\u0645\u0656","translation":"(Gunanya catitan malaikat-malaikat itu ialah: untuk menyatakan siapa yang berbakti dan siapa yang bersalah) - kerana sesungguhnya: orang-orang yang berbakti (dengan taat dan amal kebajikan), tetap berada dalam Syurga yang penuh nikmat;","footnotes":null},{"id":"5843","sura":"82","aya":"14","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0641\u064f\u062c\u0651\u064e\u0627\u0631\u064e \u0644\u064e\u0641\u0650\u064a \u062c\u064e\u062d\u0650\u064a\u0645\u0656","translation":"Dan sesungguhnya orang-orang yang bersalah, bertempat dalam neraka yang menjulang-julang.","footnotes":null},{"id":"5844","sura":"82","aya":"15","arabic_text":"\u064a\u064e\u0635\u06e1\u0644\u064e\u0648\u06e1\u0646\u064e\u0647\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"Mereka menderita bakaran neraka itu pada hari pembalasan,","footnotes":null},{"id":"5845","sura":"82","aya":"16","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0645\u06e1 \u0639\u064e\u0646\u06e1\u0647\u064e\u0627 \u0628\u0650\u063a\u064e\u0627\u0653\u0626\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Dan mereka (sentiasa berada dalam azab seksanya), tidak ghaib daripadanya.","footnotes":null},{"id":"5846","sura":"82","aya":"17","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"Dan apa jalannya engkau dapat mengetahui kedahsyatan hari pembalasan itu?","footnotes":null},{"id":"5847","sura":"82","aya":"18","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"Sekali lagi, apa jalannya engkau dapat mengetahui kedahsyatan hari pembalasan itu?","footnotes":null},{"id":"5848","sura":"82","aya":"19","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u0644\u064e\u0627 \u062a\u064e\u0645\u06e1\u0644\u0650\u0643\u064f \u0646\u064e\u0641\u06e1\u0633\u065e \u0644\u0651\u0650\u0646\u064e\u0641\u06e1\u0633\u0656 \u0634\u064e\u064a\u06e1\u0640\u0654\u0657\u0627\u06d6 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0645\u06e1\u0631\u064f \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u0651\u064e\u0647\u0650","translation":"(Hari itu ialah) hari seseorang tidak dapat memberikan pertolongan sedikitpun kepada orang lain, dan segala urusan pada hari itu tertentu bagi Allah.","footnotes":null}]}