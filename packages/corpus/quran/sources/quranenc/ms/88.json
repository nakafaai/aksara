:"Di situ juga ada pelamin-pelamin (berhias) yang tinggi (tempatnya),","footnotes":null},{"id":"5981","sura":"88","aya":"14","arabic_text":"\u0648\u064e\u0623\u064e\u0643\u06e1\u0648\u064e\u0627\u0628\u065e \u0645\u0651\u064e\u0648\u06e1\u0636\u064f\u0648\u0639\u064e\u0629\u065e","translation":"Dan piala-piala minuman yang disediakan (untuk mereka),","footnotes":null},{"id":"5982","sura":"88","aya":"15","arabic_text":"\u0648\u064e\u0646\u064e\u0645\u064e\u0627\u0631\u0650\u0642\u064f \u0645\u064e\u0635\u06e1\u0641\u064f\u0648\u0641\u064e\u0629\u065e","translation":"Dan bantal-bantal yang teratur (untuk mereka berbaring atau bersandar),","footnotes":null},{"id":"5983","sura":"88","aya":"16","arabic_text":"\u0648\u064e\u0632\u064e\u0631\u064e\u0627\u0628\u0650\u064a\u0651\u064f \u0645\u064e\u0628\u06e1\u062b\u064f\u0648\u062b\u064e\u0629\u064c","translation":"Serta hamparan-hamparan yang terbentang.","footnotes":null},{"id":"5984","sura":"88","aya":"17","arabic_text":"\u0623\u064e\u0641\u064e\u0644\u064e\u0627 \u064a\u064e\u0646\u0638\u064f\u0631\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u06e1\u0625\u0650\u0628\u0650\u0644\u0650 \u0643\u064e\u064a\u06e1\u0641\u064e \u062e\u064f\u0644\u0650\u0642\u064e\u062a\u06e1","translation":"(Mengapa mereka yang kafir masih mengingkari akhirat) tidakkah mereka memperhatikan keadaan unta bagaimana ia diciptakan?","footnotes":null},{"id":"5985","sura":"88","aya":"18","arabic_text":"\u0648\u064e\u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u0650 \u0643\u064e\u064a\u06e1\u0641\u064e \u0631\u064f\u0641\u0650\u0639\u064e\u062a\u06e1","translation":"Dan keadaan langit bagaimana ia ditinggikan binaannya.?","footnotes":null},{"id":"5986","sura":"88","aya":"19","arabic_text":"\u0648\u064e\u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u06e1\u062c\u0650\u0628\u064e\u0627\u0644\u0650 \u0643\u064e\u064a\u06e1\u0641\u064e \u0646\u064f\u0635\u0650\u0628\u064e\u062a\u06e1","translation":"Dan keadaan gunung-ganang bagaimana ia ditegakkan?","footnotes":null},{"id":"5987","sura":"88","aya":"20","arabic_text":"\u0648\u064e\u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0643\u064e\u064a\u06e1\u0641\u064e \u0633\u064f\u0637\u0650\u062d\u064e\u062a\u06e1","translation":"Dan keadaan bumi bagaimana ia dihamparkan?","footnotes":null},{"id":"5988","sura":"88","aya":"21","arabic_text":"\u0641\u064e\u0630\u064e\u0643\u0651\u0650\u0631\u06e1 \u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064e \u0645\u064f\u0630\u064e\u0643\u0651\u0650\u0631\u065e","translation":"Oleh itu berikanlah sahaja peringatan (wahai Muhammad, kepada manusia, dan janganlah berdukacita kiranya ada yang menolaknya), kerana sesungguhnya engkau hanyalah seorang Rasul pemberi ingatan;","footnotes":null},{"id":"5989","sura":"88","aya":"22","arabic_text":"\u0644\u0651\u064e\u0633\u06e1\u062a\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645 \u0628\u0650\u0645\u064f\u0635\u064e\u064a\u06e1\u0637\u0650\u0631\u064d","translation":"Bukanlah engkau seorang yang berkuasa memaksa mereka (menerima ajaran Islam yang engkau sampaikan itu).","footnotes":null},{"id":"5990","sura":"88","aya":"23","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0646 \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670 \u0648\u064e\u0643\u064e\u0641\u064e\u0631\u064e","translation":"Akan tetapi sesiapa yang berpaling (dari kebenaran) serta ia kufur ingkar, -","footnotes":null},{"id":"5991","sura":"88","aya":"24","arabic_text":"\u0641\u064e\u064a\u064f\u0639\u064e\u0630\u0651\u0650\u0628\u064f\u0647\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0671\u0644\u06e1\u0639\u064e\u0630\u064e\u0627\u0628\u064e \u0671\u0644\u06e1\u0623\u064e\u0643\u06e1\u0628\u064e\u0631\u064e","translation":"Maka Allah akan menyeksanya dengan azab seksa yang sebesar-besarnya.","footnotes":null},{"id":"5992","sura":"88","aya":"25","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0625\u0650\u0644\u064e\u064a\u06e1\u0646\u064e\u0627\u0653 \u0625\u0650\u064a\u064e\u0627\u0628\u064e\u0647\u064f\u0645\u06e1","translation":"Sesungguhnya kepada Kamilah kembalinya mereka,","footnotes":null},{"id":"5993","sura":"88","aya":"26","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u062d\u0650\u0633\u064e\u0627\u0628\u064e\u0647\u064f\u0645","translation":"Selain dari itu, sesungguhnya tanggungan Kamilah soal menghitung amal mereka.","footnotes":null}]}