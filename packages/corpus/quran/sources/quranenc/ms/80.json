{"result":[{"id":"5759","sura":"80","aya":"1","arabic_text":"\u0639\u064e\u0628\u064e\u0633\u064e \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670\u0653","translation":"Ia memasamkan muka dan berpaling,","footnotes":null},{"id":"5760","sura":"80","aya":"2","arabic_text":"\u0623\u064e\u0646 \u062c\u064e\u0627\u0653\u0621\u064e\u0647\u064f \u0671\u0644\u06e1\u0623\u064e\u0639\u06e1\u0645\u064e\u0649\u0670","translation":"Kerana ia didatangi orang buta.","footnotes":null},{"id":"5761","sura":"80","aya":"3","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064f\u062f\u06e1\u0631\u0650\u064a\u0643\u064e \u0644\u064e\u0639\u064e\u0644\u0651\u064e\u0647\u064f\u06e5 \u064a\u064e\u0632\u0651\u064e\u0643\u0651\u064e\u0649\u0670\u0653","translation":"Dan apa jalannya engkau dapat mengetahui (tujuannya, wahai Muhammad)? Barangkali ia mahu membersihkan hatinya (dengan pelajaran ugama yang didapatinya daripadamu)! -","footnotes":null},{"id":"5762","sura":"80","aya":"4","arabic_text":"\u0623\u064e\u0648\u06e1 \u064a\u064e\u0630\u0651\u064e\u0643\u0651\u064e\u0631\u064f \u0641\u064e\u062a\u064e\u0646\u0641\u064e\u0639\u064e\u0647\u064f \u0671\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u064e\u0649\u0670\u0653","translation":"Ataupun ia mahu mendapat peringatan, supaya peringatan itu memberi manfaat kepadanya.","footnotes":null},{"id":"5763","sura":"80","aya":"5","arabic_text":"\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u0650 \u0671\u0633\u06e1\u062a\u064e\u063a\u06e1\u0646\u064e\u0649\u0670","translation":"Adapun orang yang merasa keadaannya telah cukup, tidak berhajat lagi (kepada ajaran Al-Quran),","footnotes":null},{"id":"5764","sura":"80","aya":"6","arabic_text":"\u0641\u064e\u0623\u064e\u0646\u062a\u064e \u0644\u064e\u0647\u064f\u06e5 \u062a\u064e\u0635\u064e\u062f\u0651\u064e\u0649\u0670","translation":"Maka engkau bersungguh-sungguh melayaninya.","footnotes":null},{"id":"5765","sura":"80","aya":"7","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064e \u0623\u064e\u0644\u0651\u064e\u0627 \u064a\u064e\u0632\u0651\u064e\u0643\u0651\u064e\u0649\u0670","translation":"Padahal engkau tidak bersalah kalau ia tidak mahu membersihkan dirinya (dari keingkarannya).","footnotes":null},{"id":"5766","sura":"80","aya":"8","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646 \u062c\u064e\u0627\u0653\u0621\u064e\u0643\u064e \u064a\u064e\u0633\u06e1\u0639\u064e\u0649\u0670","translation":"Adapun orang yang segera datang kepadamu,","footnotes":null},{"id":"5767","sura":"80","aya":"9","arabic_text":"\u0648\u064e\u0647\u064f\u0648\u064e \u064a\u064e\u062e\u06e1\u0634\u064e\u0649\u0670","translation":"Dengan perasaan takutnya (melanggar perintah-perintah Allah), -","footnotes":null},{"id":"5768","sura":"80","aya":"10","arabic_text":"\u0641\u064e\u0623\u064e\u0646\u062a\u064e \u0639\u064e\u0646\u06e1\u0647\u064f \u062a\u064e\u0644\u064e\u0647\u0651\u064e\u0649\u0670","translation":"Maka engkau berlengah-lengah melayaninya.","footnotes":null},{"id":"5769","sura":"80","aya":"11","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e","translation":"Janganlah melakukan lagi yang sedemikian itu! Sebenarnya ayat-ayat Al-Quran adalah pengajaran dan peringatan (yang mencukupi).","footnotes":null},{"id":"5770","sura":"80","aya":"12","arabic_text":"\u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Maka sesiapa yang mahukan kebaikan dirinya, dapatlah ia mengambil peringatan daripadanya.","footnotes":null},{"id":"5771","sura":"80","aya":"13","arabic_text":"\u0641\u0650\u064a \u0635\u064f\u062d\u064f\u0641\u0656 \u0645\u0651\u064f\u0643\u064e\u0631\u0651\u064e\u0645\u064e\u0629\u0656","translation":"(Ayat-ayat Suci itu tersimpan) dalam naskhah-naskhah yang dimuliakan, -","footnotes":null},{"id":"5772","sura":"80","aya":"14","arabic_text":"\u0645\u0651\u064e\u0631\u06e1\u0641\u064f\u0648\u0639\u064e\u0629\u0656 \u0645\u0651\u064f\u0637\u064e\u0647\u0651\u064e\u0631\u064e\u0629\u0650\u06ed","translation":"Yang tinggi darjatnya, lagi suci (dari segala gangguan), -","footnotes":null},{"id":"5773","sura":"80","aya":"15","arabic_text":"\u0628\u0650\u0623\u064e\u064a\u06e1\u062f\u0650\u064a \u0633\u064e\u0641\u064e\u0631\u064e\u0629\u0656","translation":"(Terpelihara) di tangan malaikat-malaikat yang menyalinnya dari Lauh Mahfuz;","footnotes":null},{"id":"5774","sura":"80","aya":"16","arabic_text":"\u0643\u0650\u0631\u064e\u0627\u0645\u0650\u06ed \u0628\u064e\u0631\u064e\u0631\u064e\u0629\u0656","translation":"(Malaikat-malaikat) yang mulia, lagi yang berbakti.","footnotes":null},{"id":"5775","sura":"80","aya":"17","arabic_text":"\u0642\u064f\u062a\u0650\u0644\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0645\u064e\u0627\u0653 \u0623\u064e\u0643\u06e1\u0641\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Binasalah hendaknya manusia (yang ingkar) itu, betapa besar kekufurannya?","footnotes":null},{"id":"5776","sura":"80","aya":"18","arabic_text":"\u0645\u0650\u0646\u06e1 \u0623\u064e\u064a\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u064d \u062e\u064e\u0644\u064e\u0642\u064e\u0647\u064f\u06e5","translation":"(Tidakkah ia memikirkan) dari apakah ia diciptakan oleh Allah? -","footnotes":null},{"id":"5777","sura":"80","aya":"19","arabic_text":"\u0645\u0650\u0646 \u0646\u0651\u064f\u0637\u06e1\u0641\u064e\u0629\u064d \u062e\u064e\u0644\u064e\u0642\u064e\u0647\u064f\u06e5 \u0641\u064e\u0642\u064e\u062f\u0651\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Dari air mani diciptakanNya, serta dilengkapkan keadaannya dengan persediaan untuk bertanggungjawab;","footnotes":null},{"id":"5778","sura":"80","aya":"20","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0671\u0644\u0633\u0651\u064e\u0628\u0650\u064a\u0644\u064e \u064a\u064e\u0633\u0651\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Kemudian jalan (baik dan jahat), dimudahkan Tuhan kepadanya (untuk menimbang dan mengambil mana satu yang ia pilih);","footnotes":null},{"id":"5779","sura":"80","aya":"21","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0623\u064e\u0645\u064e\u0627\u062a\u064e\u0647\u064f\u06e5 \u0641\u064e\u0623\u064e\u0642\u06e1\u0628\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Kemudian dimatikannya, lalu diperintahkan supaya ia dikuburkan;","footnotes":null},{"id":"5780","sura":"80","aya":"22","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0630\u064e\u0627 \u0634\u064e\u0627\u0653\u0621\u064e \u0623\u064e\u0646\u0634\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Kemudian apabila Allah kehendaki dibangkitkannya (hidup semula).","footnotes":null},{"id":"5781","sura":"80","aya":"23","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0644\u064e\u0645\u0651\u064e\u0627 \u064a\u064e\u0642\u06e1\u0636\u0650 \u0645\u064e\u0627\u0653 \u0623\u064e\u0645\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Janganlah hendaknya ia kufur ingkar lagi! Sebenarnya ia belum menunaikan apa yang diperintahkan kepadanya.","footnotes":null},{"id":"5782","sura":"80","aya":"24","arabic_text":"\u0641\u064e\u0644\u06e1\u064a\u064e\u0646\u0638\u064f\u0631\u0650 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0625\u0650\u0644\u064e\u0649\u0670 \u0637\u064e\u0639\u064e\u0627\u0645\u0650\u0647\u0650\u06e6\u0653","translation":"(Kalaulah ia tidak memikirkan asal dan kesudahan dirinya), maka hendaklah manusia melihat kepada makanannya (bagaimana kami mentadbirkannya):","footnotes":null},{"id":"5783","sura":"80","aya":"25","arabic_text":"\u0623\u064e\u0646\u0651\u064e\u0627 \u0635\u064e\u0628\u064e\u0628\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0645\u064e\u0627\u0653\u0621\u064e \u0635\u064e\u0628\u0651\u0657\u0627","translation":"Sesungguhnya kami telah mencurahkan hujan dengan curahan yang menakjubkan.","footnotes":null},{"id":"5784","sura":"80","aya":"26","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0634\u064e\u0642\u064e\u0642\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0634\u064e\u0642\u0651\u0657\u0627","translation":"Kemudian kami belah-belahkan bumi dengan belahan yang sesuai dengan tumbuh-tumbuhan, -","footnotes":null},{"id":"5785","sura":"80","aya":"27","arabic_text":"\u0641\u064e\u0623\u064e\u0646\u06e2\u0628\u064e\u062a\u06e1\u0646\u064e\u0627 \u0641\u0650\u064a\u0647\u064e\u0627 \u062d\u064e\u0628\u0651\u0657\u0627","translation":"Lalu Kami tumbuhkan pada bumi biji-bijian,","footnotes":null},{"id":"5786","sura":"80","aya":"28","arabic_text":"\u0648\u064e\u0639\u0650\u0646\u064e\u0628\u0657\u0627 \u0648\u064e\u0642\u064e\u0636\u06e1\u0628\u0657\u0627","translation":"Dan buah anggur serta sayur-sayuran,","footnotes":null},{"id":"5787","sura":"80","aya":"29","arabic_text":"\u0648\u064e\u0632\u064e\u064a\u06e1\u062a\u064f\u0648\u0646\u0657\u0627 \u0648\u064e\u0646\u064e\u062e\u06e1\u0644\u0657\u0627","translation":"Dan Zaitun serta pohon-pohon kurma,","footnotes":null},{"id":"5788","sura":"80","aya":"30","arabic_text":"\u0648\u064e\u062d\u064e\u062f\u064e\u0627\u0653\u0626\u0650\u0642\u064e \u063a\u064f\u0644\u06e1\u0628\u0657\u0627","translation":"Dan taman-taman yang menghijau subur,","footnotes":null},{"id":"5789","sura":"80","aya":"31","arabic_text":"\u0648\u064e\u0641\u064e\u0670\u0643\u0650\u0647\u064e\u0629\u0657 \u0648\u064e\u0623\u064e\u0628\u0651\u0657\u0627","translation":"Dan berbagai buah-buahan serta bermacam-macam rumput, -","footnotes":null},{"id":"5790","sura":"80","aya":"32","arabic_text":"\u0645\u0651\u064e\u062a\u064e\u0670\u0639\u0657\u0627 \u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u0644\u0650\u0623\u064e\u0646\u06e1\u0639\u064e\u0670\u0645\u0650\u0643\u064f\u0645\u06e1","translation":"Untuk kegunaan kamu dan binatang-binatang ternak kamu.","footnotes":null},{"id":"5791","sura":"80","aya":"33","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u062c\u064e\u0627\u0653\u0621\u064e\u062a\u0650 \u0671\u0644\u0635\u0651\u064e\u0627\u0653\u062e\u0651\u064e\u0629\u064f","translation":"Kemudian (ingatlah keadaan yang berlaku) apabila datang suara jeritan yang dahsyat, -","footnotes":null},{"id":"5792","sura":"80","aya":"34","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0641\u0650\u0631\u0651\u064f \u0671\u0644\u06e1\u0645\u064e\u0631\u06e1\u0621\u064f \u0645\u0650\u0646\u06e1 \u0623\u064e\u062e\u0650\u064a\u0647\u0650","translation":"Pada hari seseorang itu lari dari saudaranya,","footnotes":null},{"id":"5793","sura":"80","aya":"35","arabic_text":"\u0648\u064e\u0623\u064f\u0645\u0651\u0650\u0647\u0650\u06e6 \u0648\u064e\u0623\u064e\u0628\u0650\u064a\u0647\u0650","translation":"Dan ibunya serta bapanya,","footnotes":null},{"id":"5794","sura":"80","aya":"36","arabic_text":"\u0648\u064e\u0635\u064e\u0670\u062d\u0650\u0628\u064e\u062a\u0650\u0647\u0650\u06e6 \u0648\u064e\u0628\u064e\u0646\u0650\u064a\u0647\u0650","translation":"Dan isterinya serta anak-anaknya; -","footnotes":null},{"id":"5795","sura":"80","aya":"37","arabic_text":"\u0644\u0650\u0643\u064f\u0644\u0651\u0650 \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0634\u064e\u0623\u06e1\u0646\u065e \u064a\u064f\u063a\u06e1\u0646\u0650\u064a\u0647\u0650","translation":"Kerana tiap-tiap seorang dari mereka pada hari itu, ada perkara-perkara yang cukup untuk menjadikannya sibuk dengan hal dirinya sahaja.","footnotes":null},{"id":"5796","sura":"80","aya":"38","arabic_text":"\u0648\u064f\u062c\u064f\u0648\u0647\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0645\u0651\u064f\u0633\u06e1\u0641\u0650\u0631\u064e\u0629\u065e","translation":"Muka (orang-orang yang beriman) pada hari itu berseri-seri,","footnotes":null},{"id":"5797","sura":"80","aya":"39","arabic_text":"\u0636\u064e\u0627\u062d\u0650\u0643\u064e\u0629\u065e \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0628\u06e1\u0634\u0650\u0631\u064e\u0629\u065e","translation":"Tertawa, lagi bersuka ria;","footnotes":null},{"id":"5798","sura":"80","aya":"40","arabic_text":"\u0648\u064e\u0648\u064f\u062c\u064f\u0648\u0647\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u064d \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u064e\u0627 \u063a\u064e\u0628\u064e\u0631\u064e\u0629\u065e","translation":"Dan muka (orang-orang yang ingkar) pada hari itu penuh berdebu,","footnotes":null},{"id":"5799","sura":"80","aya":"41","arabic_text":"\u062a\u064e\u0631\u06e1\u0647\u064e\u0642\u064f\u0647\u064e\u0627 \u0642\u064e\u062a\u064e\u0631\u064e\u0629\u064c","translation":"Diliputi oleh warna hitam legam dan gelap-gelita. -","footnotes":null},{"id":"5800","sura":"80","aya":"42","arabic_text":"\u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u0643\u064e\u0641\u064e\u0631\u064e\u0629\u064f \u0671\u0644\u06e1\u0641\u064e\u062c\u064e\u0631\u064e\u0629\u064f","translation":"Mereka itu ialah orang-orang yang kafir, yang derhaka.","footnotes":null}]}