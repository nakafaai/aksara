{"result":[{"id":"5376","sura":"70","aya":"1","arabic_text":"\u0633\u064e\u0623\u064e\u0644\u064e \u0633\u064e\u0627\u0653\u0626\u0650\u0644\u064f\u06e2 \u0628\u0650\u0639\u064e\u0630\u064e\u0627\u0628\u0656 \u0648\u064e\u0627\u0642\u0650\u0639\u0656","translation":"Salah seorang (dari kalangan orang-orang kafir Makkah, secara mengejek-ejek) meminta kedatangan azab yang (dijanjikan) akan berlaku,","footnotes":null},{"id":"5377","sura":"70","aya":"2","arabic_text":"\u0644\u0651\u0650\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e \u0644\u064e\u064a\u06e1\u0633\u064e \u0644\u064e\u0647\u064f\u06e5 \u062f\u064e\u0627\u0641\u0650\u0639\u065e","translation":"Azab yang disediakan untuk orang-orang yang kafir, yang tidak ada sesiapapun dapat menolak kedatangannya -","footnotes":null},{"id":"5378","sura":"70","aya":"3","arabic_text":"\u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0630\u0650\u064a \u0671\u0644\u06e1\u0645\u064e\u0639\u064e\u0627\u0631\u0650\u062c\u0650","translation":"Dari Allah yang menguasai tempat-tempat turun naik -","footnotes":null},{"id":"5379","sura":"70","aya":"4","arabic_text":"\u062a\u064e\u0639\u06e1\u0631\u064f\u062c\u064f \u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064f \u0648\u064e\u0671\u0644\u0631\u0651\u064f\u0648\u062d\u064f \u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650 \u0641\u0650\u064a \u064a\u064e\u0648\u06e1\u0645\u0656 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0642\u06e1\u062f\u064e\u0627\u0631\u064f\u0647\u064f\u06e5 \u062e\u064e\u0645\u06e1\u0633\u0650\u064a\u0646\u064e \u0623\u064e\u0644\u06e1\u0641\u064e \u0633\u064e\u0646\u064e\u0629\u0656","translation":"Yang dilalui oleh malaikat-malaikat dan Jibril ke pusat pemerintahanNya (untuk menerima dan menyempurnakan tugas masing-masing, terutama) pada satu masa yang adalah tempohnya (dirasai oleh orang-orang yang bersalah) sungguh panjang, (kerana banyak hitungan hisab dan berat soal jawabnya).","footnotes":null},{"id":"5380","sura":"70","aya":"5","arabic_text":"\u0641\u064e\u0671\u0635\u06e1\u0628\u0650\u0631\u06e1 \u0635\u064e\u0628\u06e1\u0631\u0657\u0627 \u062c\u064e\u0645\u0650\u064a\u0644\u064b\u0627","translation":"Maka bersabarlah (wahai Muhammad terhadap ejekan golongan yang kafir itu), dengan cara kesabaran yang sebaik-baiknya.","footnotes":null},{"id":"5381","sura":"70","aya":"6","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u064a\u064e\u0631\u064e\u0648\u06e1\u0646\u064e\u0647\u064f\u06e5 \u0628\u064e\u0639\u0650\u064a\u062f\u0657\u0627","translation":"Sebenarnya mereka memandang azab itu jauh (daripada berlaku),","footnotes":null},{"id":"5382","sura":"70","aya":"7","arabic_text":"\u0648\u064e\u0646\u064e\u0631\u064e\u0649\u0670\u0647\u064f \u0642\u064e\u0631\u0650\u064a\u0628\u0657\u0627","translation":"Sedang Kami memandangnya dekat, (tetap akan berlaku),","footnotes":null},{"id":"5383","sura":"70","aya":"8","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u062a\u064e\u0643\u064f\u0648\u0646\u064f \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0643\u064e\u0671\u0644\u06e1\u0645\u064f\u0647\u06e1\u0644\u0650","translation":"(Iaitu) pada hari langit menjadi seperti tembaga cair,","footnotes":null},{"id":"5384","sura":"70","aya":"9","arabic_text":"\u0648\u064e\u062a\u064e\u0643\u064f\u0648\u0646\u064f \u0671\u0644\u06e1\u062c\u0650\u0628\u064e\u0627\u0644\u064f \u0643\u064e\u0671\u0644\u06e1\u0639\u0650\u0647\u06e1\u0646\u0650","translation":"Dan gunung-ganang pula menjadi seperti bulu (yang berterbangan)","footnotes":null},{"id":"5385","sura":"70","aya":"10","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f \u062d\u064e\u0645\u0650\u064a\u0645\u064c \u062d\u064e\u0645\u0650\u064a\u0645\u0657\u0627","translation":"Dan sahabat karib tidak bertanyakan hal sahabat karibnya, (kerana tiap-tiap seorang sibuk memikirkan hal keadaannya sendiri),","footnotes":null},{"id":"5386","sura":"70","aya":"11","arabic_text":"\u064a\u064f\u0628\u064e\u0635\u0651\u064e\u0631\u064f\u0648\u0646\u064e\u0647\u064f\u0645\u06e1\u06da \u064a\u064e\u0648\u064e\u062f\u0651\u064f \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u064f \u0644\u064e\u0648\u06e1 \u064a\u064e\u0641\u06e1\u062a\u064e\u062f\u0650\u064a \u0645\u0650\u0646\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u064a\u064e\u0648\u06e1\u0645\u0650\u0626\u0650\u0630\u0650\u06ed \u0628\u0650\u0628\u064e\u0646\u0650\u064a\u0647\u0650","translation":"Padahal masing-masing diberi melihat setengahnya yang lain; (pada saat yang demikian) orang yang kafir suka kiranya dapat menebus dirinya dari azab itu dengan anak-anaknya sendiri,","footnotes":null},{"id":"5387","sura":"70","aya":"12","arabic_text":"\u0648\u064e\u0635\u064e\u0670\u062d\u0650\u0628\u064e\u062a\u0650\u0647\u0650\u06e6 \u0648\u064e\u0623\u064e\u062e\u0650\u064a\u0647\u0650","translation":"Dan isteri serta saudaranya,","footnotes":null},{"id":"5388","sura":"70","aya":"13","arabic_text":"\u0648\u064e\u0641\u064e\u0635\u0650\u064a\u0644\u064e\u062a\u0650\u0647\u0650 \u0671\u0644\u0651\u064e\u062a\u0650\u064a \u062a\u064f\u0640\u0654\u06e1\u0648\u0650\u064a\u0647\u0650","translation":"Dan kaum kerabatnya yang melindunginya,","footnotes":null},{"id":"5389","sura":"70","aya":"14","arabic_text":"\u0648\u064e\u0645\u064e\u0646 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u062c\u064e\u0645\u0650\u064a\u0639\u0657\u0627 \u062b\u064f\u0645\u0651\u064e \u064a\u064f\u0646\u062c\u0650\u064a\u0647\u0650","translation":"Dan juga sekalian makhluk yang ada di bumi - kemudian (diharapkannya) tebusan itu dapat menyelamatkannya.","footnotes":null},{"id":"5390","sura":"70","aya":"15","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u0644\u064e\u0638\u064e\u0649\u0670","translation":"Tidak sekali-kali (sebagaimana yang diharapkannya)! Sesungguhnya neraka (yang disediakan baginya) tetap menjulang-julang apinya,","footnotes":null},{"id":"5391","sura":"70","aya":"16","arabic_text":"\u0646\u064e\u0632\u0651\u064e\u0627\u0639\u064e\u0629\u0657 \u0644\u0651\u0650\u0644\u0634\u0651\u064e\u0648\u064e\u0649\u0670","translation":"(Membakar serta) menggugurkan kulit ubun-ubun dan anggota anggota tubuh badan,","footnotes":null},{"id":"5392","sura":"70","aya":"17","arabic_text":"\u062a\u064e\u062f\u06e1\u0639\u064f\u0648\u0627\u0652 \u0645\u064e\u0646\u06e1 \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670","translation":"Neraka itu juga memanggil dan menarik orang yang membelakangi serta berpaling (dari kebenaran),","footnotes":null},{"id":"5393","sura":"70","aya":"18","arabic_text":"\u0648\u064e\u062c\u064e\u0645\u064e\u0639\u064e \u0641\u064e\u0623\u064e\u0648\u06e1\u0639\u064e\u0649\u0670\u0653","translation":"Dan yang mengumpulkan harta kekayaan lalu menyimpannya (dengan tidak membayar zakatnya).","footnotes":null},{"id":"5394","sura":"70","aya":"19","arabic_text":"\u06de\u00a0\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u062e\u064f\u0644\u0650\u0642\u064e \u0647\u064e\u0644\u064f\u0648\u0639\u064b\u0627","translation":"Sesungguhnya manusia itu dijadikan bertabiat resah gelisah (lagi bakhil kedekut); -","footnotes":null},{"id":"5395","sura":"70","aya":"20","arabic_text":"\u0625\u0650\u0630\u064e\u0627 \u0645\u064e\u0633\u0651\u064e\u0647\u064f \u0671\u0644\u0634\u0651\u064e\u0631\u0651\u064f \u062c\u064e\u0632\u064f\u0648\u0639\u0657\u0627","translation":"Apabila ia ditimpa kesusahan, dia sangat resah gelisah;","footnotes":null},{"id":"5396","sura":"70","aya":"21","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0645\u064e\u0633\u0651\u064e\u0647\u064f \u0671\u0644\u06e1\u062e\u064e\u064a\u06e1\u0631\u064f \u0645\u064e\u0646\u064f\u0648\u0639\u064b\u0627","translation":"Dan apabila ia beroleh kesenangan, ia sangat bakhil kedekut;","footnotes":null},{"id":"5397","sura":"70","aya":"22","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u0635\u064e\u0644\u0651\u0650\u064a\u0646\u064e","translation":"Kecuali orang-orang yang mengerjakan sembahyang -","footnotes":null},{"id":"5398","sura":"70","aya":"23","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u06e1 \u0639\u064e\u0644\u064e\u0649\u0670 \u0635\u064e\u0644\u064e\u0627\u062a\u0650\u0647\u0650\u0645\u06e1 \u062f\u064e\u0627\u0653\u0626\u0650\u0645\u064f\u0648\u0646\u064e","translation":"Iaitu mereka yang tetap mengerjakan sembahyangnya;","footnotes":null},{"id":"5399","sura":"70","aya":"24","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u0650\u064a\u0653 \u0623\u064e\u0645\u06e1\u0648\u064e\u0670\u0644\u0650\u0647\u0650\u0645\u06e1 \u062d\u064e\u0642\u0651\u065e \u0645\u0651\u064e\u0639\u06e1\u0644\u064f\u0648\u0645\u065e","translation":"Dan mereka (yang menentukan bahagian) pada harta-hartanya, menjadi hak yang termaklum -","footnotes":null},{"id":"5400","sura":"70","aya":"25","arabic_text":"\u0644\u0651\u0650\u0644\u0633\u0651\u064e\u0627\u0653\u0626\u0650\u0644\u0650 \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u062d\u06e1\u0631\u064f\u0648\u0645\u0650","translation":"Bagi orang miskin yang meminta dan orang miskin yang menahan diri (daripada meminta);","footnotes":null},{"id":"5401","sura":"70","aya":"26","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064f\u0635\u064e\u062f\u0651\u0650\u0642\u064f\u0648\u0646\u064e \u0628\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"Dan mereka yang percayakan hari pembalasan (dengan mengerjakan amal-amal yang soleh sebagai buktinya);","footnotes":null},{"id":"5402","sura":"70","aya":"27","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645 \u0645\u0651\u064f\u0634\u06e1\u0641\u0650\u0642\u064f\u0648\u0646\u064e","translation":"Dan mereka yang cemas takut daripada ditimpa azab Tuhannya, -","footnotes":null},{"id":"5403","sura":"70","aya":"28","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0630\u064e\u0627\u0628\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u06e1 \u063a\u064e\u064a\u06e1\u0631\u064f \u0645\u064e\u0623\u06e1\u0645\u064f\u0648\u0646\u0656","translation":"Kerana sesungguhnya azab Tuhan mereka, tidak patut (bagi seseorangpun) merasa aman terhadapnya;","footnotes":null},{"id":"5404","sura":"70","aya":"29","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u06e1 \u0644\u0650\u0641\u064f\u0631\u064f\u0648\u062c\u0650\u0647\u0650\u0645\u06e1 \u062d\u064e\u0670\u0641\u0650\u0638\u064f\u0648\u0646\u064e","translation":"Dan mereka yang menjaga kehormatannya, -","footnotes":null},{"id":"5405","sura":"70","aya":"30","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0632\u06e1\u0648\u064e\u0670\u062c\u0650\u0647\u0650\u0645\u06e1 \u0623\u064e\u0648\u06e1 \u0645\u064e\u0627 \u0645\u064e\u0644\u064e\u0643\u064e\u062a\u06e1 \u0623\u064e\u064a\u06e1\u0645\u064e\u0670\u0646\u064f\u0647\u064f\u0645\u06e1 \u0641\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u063a\u064e\u064a\u06e1\u0631\u064f \u0645\u064e\u0644\u064f\u0648\u0645\u0650\u064a\u0646\u064e","translation":"Kecuali kepada isterinya atau kepada hambanya, maka sesungguhnya mereka tidak tercela;","footnotes":null},{"id":"5406","sura":"70","aya":"31","arabic_text":"\u0641\u064e\u0645\u064e\u0646\u0650 \u0671\u0628\u06e1\u062a\u064e\u063a\u064e\u0649\u0670 \u0648\u064e\u0631\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0641\u064e\u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u0639\u064e\u0627\u062f\u064f\u0648\u0646\u064e","translation":"Kemudian sesiapa yang mengingini selain dari yang demikian, maka merekalah orang-orang yang melampaui batas;","footnotes":null},{"id":"5407","sura":"70","aya":"32","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u06e1 \u0644\u0650\u0623\u064e\u0645\u064e\u0670\u0646\u064e\u0670\u062a\u0650\u0647\u0650\u0645\u06e1 \u0648\u064e\u0639\u064e\u0647\u06e1\u062f\u0650\u0647\u0650\u0645\u06e1 \u0631\u064e\u0670\u0639\u064f\u0648\u0646\u064e","translation":"Dan mereka yang menjaga amanah dan janjinya;","footnotes":null},{"id":"5408","sura":"70","aya":"33","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645 \u0628\u0650\u0634\u064e\u0647\u064e\u0670\u062f\u064e\u0670\u062a\u0650\u0647\u0650\u0645\u06e1 \u0642\u064e\u0627\u0653\u0626\u0650\u0645\u064f\u0648\u0646\u064e","translation":"Dan mereka yang memberikan keterangan dengan benar lagi adil (semasa mereka menjadi saksi);","footnotes":null},{"id":"5409","sura":"70","aya":"34","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u06e1 \u0639\u064e\u0644\u064e\u0649\u0670 \u0635\u064e\u0644\u064e\u0627\u062a\u0650\u0647\u0650\u0645\u06e1 \u064a\u064f\u062d\u064e\u0627\u0641\u0650\u0638\u064f\u0648\u0646\u064e","translation":"Dan mereka yang tetap memelihara sembahyangnya;","footnotes":null},{"id":"5410","sura":"70","aya":"35","arabic_text":"\u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u0645\u0651\u064f\u0643\u06e1\u0631\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Mereka (yang demikian sifatnya) ditempatkan di dalam Syurga dengan diberikan penghormatan.","footnotes":null},{"id":"5411","sura":"70","aya":"36","arabic_text":"\u0641\u064e\u0645\u064e\u0627\u0644\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0642\u0650\u0628\u064e\u0644\u064e\u0643\u064e \u0645\u064f\u0647\u06e1\u0637\u0650\u0639\u0650\u064a\u0646\u064e","translation":"Maka apakah yang menyebabkan orang-orang kafir, yang menentangmu (wahai Muhammad) datang berkejaran ke sisimu -","footnotes":null},{"id":"5412","sura":"70","aya":"37","arabic_text":"\u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650 \u0648\u064e\u0639\u064e\u0646\u0650 \u0671\u0644\u0634\u0651\u0650\u0645\u064e\u0627\u0644\u0650 \u0639\u0650\u0632\u0650\u064a\u0646\u064e","translation":"(Sambil mereka) berkumpul berpuak-puak di sebelah kanan dan di sebelah kirimu.","footnotes":null},{"id":"5413","sura":"70","aya":"38","arabic_text":"\u0623\u064e\u064a\u064e\u0637\u06e1\u0645\u064e\u0639\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u062f\u06e1\u062e\u064e\u0644\u064e \u062c\u064e\u0646\u0651\u064e\u0629\u064e \u0646\u064e\u0639\u0650\u064a\u0645\u0656","translation":"Patutkah tiap-tiap seorang dari mereka berharap supaya dimasukkan ke dalam Syurga yang penuh nikmat (sedang ia tidak beriman)?","footnotes":null},{"id":"5414","sura":"70","aya":"39","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0627 \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0647\u064f\u0645 \u0645\u0651\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Tidak sekali-kali! (Mereka yang kufur ingkar tidak akan dapat memasukinya). Sesungguhnya Kami telah menciptakan mereka dari apa yang mereka sedia mengetahuinya.","footnotes":null},{"id":"5415","sura":"70","aya":"40","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0631\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0645\u064e\u0634\u064e\u0670\u0631\u0650\u0642\u0650 \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u063a\u064e\u0670\u0631\u0650\u0628\u0650 \u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0642\u064e\u0670\u062f\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Maka Aku bersumpah dengan (kebesaranKu) Tuhan yang menguasai (seluruh alam, meliputi) tempat-tempat terbit (matahari dan bulan bintang) dan tempat-tempat tenggelamnya, - sesungguhnya Kami berkuasa -","footnotes":null},{"id":"5416","sura":"70","aya":"41","arabic_text":"\u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u0646\u0651\u064f\u0628\u064e\u062f\u0651\u0650\u0644\u064e \u062e\u064e\u064a\u06e1\u0631\u0657\u0627 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0628\u0650\u0645\u064e\u0633\u06e1\u0628\u064f\u0648\u0642\u0650\u064a\u0646\u064e","translation":"(Membinasakan mereka, serta) menggantikan mereka dengan makhluk-makluk yang lebih baik dari mereka; dan Kami tidak sekali-kali dapat dikalahkan atau dilemahkan.","footnotes":null},{"id":"5417","sura":"70","aya":"42","arabic_text":"\u0641\u064e\u0630\u064e\u0631\u06e1\u0647\u064f\u0645\u06e1 \u064a\u064e\u062e\u064f\u0648\u0636\u064f\u0648\u0627\u0652 \u0648\u064e\u064a\u064e\u0644\u06e1\u0639\u064e\u0628\u064f\u0648\u0627\u0652 \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u064a\u064f\u0644\u064e\u0670\u0642\u064f\u0648\u0627\u0652 \u064a\u064e\u0648\u06e1\u0645\u064e\u0647\u064f\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"Oleh itu, biarkanlah mereka (wahai Muhammad) tenggelam dalam kesesatannya dan leka bermain-main (dalam dunianya), sehingga mereka menemui hari yang dijanjikan kepada mereka (untuk menerima balasan)! -","footnotes":null},{"id":"5418","sura":"70","aya":"43","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u062e\u06e1\u0631\u064f\u062c\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u062c\u06e1\u062f\u064e\u0627\u062b\u0650 \u0633\u0650\u0631\u064e\u0627\u0639\u0657\u0627 \u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u064e\u0649\u0670 \u0646\u064f\u0635\u064f\u0628\u0656 \u064a\u064f\u0648\u0641\u0650\u0636\u064f\u0648\u0646\u064e","translation":"Iaitu hari mereka segera keluar dari kubur masing-masing menuju (ke Padang Mahsyar) dengan keadaan seolah-olah mereka berkejaran ke (tempat) berhala-berhala (yang mereka sembah dahulu),","footnotes":null},{"id":"5419","sura":"70","aya":"44","arabic_text":"\u062e\u064e\u0670\u0634\u0650\u0639\u064e\u0629\u064b \u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u064f\u0647\u064f\u0645\u06e1 \u062a\u064e\u0631\u06e1\u0647\u064e\u0642\u064f\u0647\u064f\u0645\u06e1 \u0630\u0650\u0644\u0651\u064e\u0629\u065e\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"Sambil pandangan mereka tunduk, serta mereka diliputi kehinaan; itulah hari yang telah dijanjikan kepada mereka.","footnotes":null}]}