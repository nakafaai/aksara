{"result":[{"id":"5496","sura":"74","aya":"1","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u062f\u0651\u064e\u062b\u0651\u0650\u0631\u064f","translation":"Wahai orang yang berselimut!","footnotes":null},{"id":"5497","sura":"74","aya":"2","arabic_text":"\u0642\u064f\u0645\u06e1 \u0641\u064e\u0623\u064e\u0646\u0630\u0650\u0631\u06e1","translation":"Bangunlah serta berilah peringatan dan amaran (kepada umat manusia).","footnotes":null},{"id":"5498","sura":"74","aya":"3","arabic_text":"\u0648\u064e\u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0641\u064e\u0643\u064e\u0628\u0651\u0650\u0631\u06e1","translation":"Dan Tuhanmu, maka ucaplah dan ingatlah kebesaranNya!","footnotes":null},{"id":"5499","sura":"74","aya":"4","arabic_text":"\u0648\u064e\u062b\u0650\u064a\u064e\u0627\u0628\u064e\u0643\u064e \u0641\u064e\u0637\u064e\u0647\u0651\u0650\u0631\u06e1","translation":"Dan pakaianmu, maka hendaklah engkau bersihkan.","footnotes":null},{"id":"5500","sura":"74","aya":"5","arabic_text":"\u0648\u064e\u0671\u0644\u0631\u0651\u064f\u062c\u06e1\u0632\u064e \u0641\u064e\u0671\u0647\u06e1\u062c\u064f\u0631\u06e1","translation":"Dan segala kejahatan, maka hendaklah engkau jauhi.","footnotes":null},{"id":"5501","sura":"74","aya":"6","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0645\u06e1\u0646\u064f\u0646 \u062a\u064e\u0633\u06e1\u062a\u064e\u0643\u06e1\u062b\u0650\u0631\u064f","translation":"Dan janganlah engkau memberi (sesuatu, dengan tujuan hendak) mendapat lebih banyak daripadanya.","footnotes":null},{"id":"5502","sura":"74","aya":"7","arabic_text":"\u0648\u064e\u0644\u0650\u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0641\u064e\u0671\u0635\u06e1\u0628\u0650\u0631\u06e1","translation":"Dan bagi (menjalankan perintah) Tuhanmu, maka hendaklah engkau bersabar (terhadap tentangan musuh)!","footnotes":null},{"id":"5503","sura":"74","aya":"8","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0646\u064f\u0642\u0650\u0631\u064e \u0641\u0650\u064a \u0671\u0644\u0646\u0651\u064e\u0627\u0642\u064f\u0648\u0631\u0650","translation":"Kerana apabila telah ditiup sangkakala,","footnotes":null},{"id":"5504","sura":"74","aya":"9","arabic_text":"\u0641\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u064a\u064e\u0648\u06e1\u0645\u064c \u0639\u064e\u0633\u0650\u064a\u0631\u064c","translation":"Maka saat yang demikian adalah saat (berlakunya) hari yang sukar -","footnotes":null},{"id":"5505","sura":"74","aya":"10","arabic_text":"\u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e \u063a\u064e\u064a\u06e1\u0631\u064f \u064a\u064e\u0633\u0650\u064a\u0631\u0656","translation":"Kepada orang-orang kafir, lagi tidak mudah (mengelak azabnya).","footnotes":null},{"id":"5506","sura":"74","aya":"11","arabic_text":"\u0630\u064e\u0631\u06e1\u0646\u0650\u064a \u0648\u064e\u0645\u064e\u0646\u06e1 \u062e\u064e\u0644\u064e\u0642\u06e1\u062a\u064f \u0648\u064e\u062d\u0650\u064a\u062f\u0657\u0627","translation":"(Jangan engkau bimbang wahai Muhammad) biarkanlah Aku sahaja membalas orang (yang menentangmu) yang Aku ciptakan dia (dalam keadaan) seorang diri (tidak berharta dan anak pinak),","footnotes":null},{"id":"5507","sura":"74","aya":"12","arabic_text":"\u0648\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u062a\u064f \u0644\u064e\u0647\u064f\u06e5 \u0645\u064e\u0627\u0644\u0657\u0627 \u0645\u0651\u064e\u0645\u06e1\u062f\u064f\u0648\u062f\u0657\u0627","translation":"Dan Aku jadikan baginya harta kekayaan yang banyak,","footnotes":null},{"id":"5508","sura":"74","aya":"13","arabic_text":"\u0648\u064e\u0628\u064e\u0646\u0650\u064a\u0646\u064e \u0634\u064f\u0647\u064f\u0648\u062f\u0657\u0627","translation":"Serta anak pinak (yang ramai), yang sentiasa ada di sisinya.","footnotes":null},{"id":"5509","sura":"74","aya":"14","arabic_text":"\u0648\u064e\u0645\u064e\u0647\u0651\u064e\u062f\u062a\u0651\u064f \u0644\u064e\u0647\u064f\u06e5 \u062a\u064e\u0645\u06e1\u0647\u0650\u064a\u062f\u0657\u0627","translation":"Dan Aku mudahkan baginya (mendapat kekayaan dan kekuasaan) dengan semudah-mudahnya.","footnotes":null},{"id":"5510","sura":"74","aya":"15","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u064a\u064e\u0637\u06e1\u0645\u064e\u0639\u064f \u0623\u064e\u0646\u06e1 \u0623\u064e\u0632\u0650\u064a\u062f\u064e","translation":"Kemudian ia ingin sangat, supaya Aku tambahi lagi;","footnotes":null},{"id":"5511","sura":"74","aya":"16","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0644\u0650\u0623\u0653\u064a\u064e\u0670\u062a\u0650\u0646\u064e\u0627 \u0639\u064e\u0646\u0650\u064a\u062f\u0657\u0627","translation":"Tidak sekali-kali (akan ditambahi)! Kerana sesungguhnya dia menentang dengan degilnya akan ayat-ayat Kami (Al-Quran, yang disampaikan oleh Rasul Kami).","footnotes":null},{"id":"5512","sura":"74","aya":"17","arabic_text":"\u0633\u064e\u0623\u064f\u0631\u06e1\u0647\u0650\u0642\u064f\u0647\u064f\u06e5 \u0635\u064e\u0639\u064f\u0648\u062f\u064b\u0627","translation":"Aku akan menyeksanya (dengan azab) yang memuncak beratnya.","footnotes":null},{"id":"5513","sura":"74","aya":"18","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0641\u064e\u0643\u0651\u064e\u0631\u064e \u0648\u064e\u0642\u064e\u062f\u0651\u064e\u0631\u064e","translation":"Kerana sesungguhnya ia telah memikirkan dan mereka-reka berbagai tuduhan terhadap Al-Quran) -","footnotes":null},{"id":"5514","sura":"74","aya":"19","arabic_text":"\u0641\u064e\u0642\u064f\u062a\u0650\u0644\u064e \u0643\u064e\u064a\u06e1\u0641\u064e \u0642\u064e\u062f\u0651\u064e\u0631\u064e","translation":"Maka binasalah dia hendaknya! Bagaimanakah dia berani mereka-reka (yang demikian)?","footnotes":null},{"id":"5515","sura":"74","aya":"20","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0642\u064f\u062a\u0650\u0644\u064e \u0643\u064e\u064a\u06e1\u0641\u064e \u0642\u064e\u062f\u0651\u064e\u0631\u064e","translation":"Sekali lagi: binasalah dia hendaknya! Bagaimana ia berani mereka-reka (tuduhan-tuduhan itu)?","footnotes":null},{"id":"5516","sura":"74","aya":"21","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0646\u064e\u0638\u064e\u0631\u064e","translation":"Kemudian ia merenung dan memikirkan (berkali-kali: jalan-jalan mencaci Al-Quran, tetapi ia gagal);","footnotes":null},{"id":"5517","sura":"74","aya":"22","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0639\u064e\u0628\u064e\u0633\u064e \u0648\u064e\u0628\u064e\u0633\u064e\u0631\u064e","translation":"Setelah itu ia memasamkan mukanya serta ia bertambah masam berkerut;","footnotes":null},{"id":"5518","sura":"74","aya":"23","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e \u0648\u064e\u0671\u0633\u06e1\u062a\u064e\u0643\u06e1\u0628\u064e\u0631\u064e","translation":"Kemudian ia berpaling (dari kebenaran) dan berlaku sombong angkuh,","footnotes":null},{"id":"5519","sura":"74","aya":"24","arabic_text":"\u0641\u064e\u0642\u064e\u0627\u0644\u064e \u0625\u0650\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0633\u0650\u062d\u06e1\u0631\u065e \u064a\u064f\u0624\u06e1\u062b\u064e\u0631\u064f","translation":"Serta ia berkata: \u201c(Al-Quran) ini tidak lain hanyalah sihir yang dituntut serta dipelajari (dari ahli-ahlinya);","footnotes":null},{"id":"5520","sura":"74","aya":"25","arabic_text":"\u0625\u0650\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0642\u064e\u0648\u06e1\u0644\u064f \u0671\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"\u201cIni tidak lain hanyalah kata-kata (rekaan) manusia!\u201d","footnotes":null},{"id":"5521","sura":"74","aya":"26","arabic_text":"\u0633\u064e\u0623\u064f\u0635\u06e1\u0644\u0650\u064a\u0647\u0650 \u0633\u064e\u0642\u064e\u0631\u064e","translation":"(Disebabkan kekufurannya itu) Aku akan masukkan dia ke dalam neraka Saqar.","footnotes":null},{"id":"5522","sura":"74","aya":"27","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u0633\u064e\u0642\u064e\u0631\u064f","translation":"Dan apa jalannya engkau dapat mengetahui kedahsyatan neraka Saqar itu?","footnotes":null},{"id":"5523","sura":"74","aya":"28","arabic_text":"\u0644\u064e\u0627 \u062a\u064f\u0628\u06e1\u0642\u0650\u064a \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0631\u064f","translation":"Ia membakar mangsanya dengan tidak meninggalkan sisa, dan tidak membiarkannya (binasa terus)","footnotes":null},{"id":"5524","sura":"74","aya":"29","arabic_text":"\u0644\u064e\u0648\u0651\u064e\u0627\u062d\u064e\u0629\u065e \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"Ia terus-menerus membakar kulit manusia!","footnotes":null},{"id":"5525","sura":"74","aya":"30","arabic_text":"\u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u064e\u0627 \u062a\u0650\u0633\u06e1\u0639\u064e\u0629\u064e \u0639\u064e\u0634\u064e\u0631\u064e","translation":"Pengawal dan penjaganya adalah sembilan belas (malaikat).","footnotes":null},{"id":"5526","sura":"74","aya":"31","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u0657\u06d6 \u0648\u064e\u0645\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0639\u0650\u062f\u0651\u064e\u062a\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u0650\u062a\u06e1\u0646\u064e\u0629\u0657 \u0644\u0651\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0644\u0650\u064a\u064e\u0633\u06e1\u062a\u064e\u064a\u06e1\u0642\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u064a\u064e\u0632\u06e1\u062f\u064e\u0627\u062f\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u064a\u0645\u064e\u0670\u0646\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u062a\u064e\u0627\u0628\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0648\u064e\u0644\u0650\u064a\u064e\u0642\u064f\u0648\u0644\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0642\u064f\u0644\u064f\u0648\u0628\u0650\u0647\u0650\u0645 \u0645\u0651\u064e\u0631\u064e\u0636\u065e \u0648\u064e\u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e \u0645\u064e\u0627\u0630\u064e\u0627\u0653 \u0623\u064e\u0631\u064e\u0627\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0645\u064e\u062b\u064e\u0644\u0657\u0627\u06da \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064f\u0636\u0650\u0644\u0651\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0647\u06e1\u062f\u0650\u064a \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u06da \u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u062c\u064f\u0646\u064f\u0648\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u06da \u0648\u064e\u0645\u064e\u0627 \u0647\u0650\u064a\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670 \u0644\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"Dan (ketahuilah bahawa hikmat) Kami tidak menjadikan pengawal-pengawal neraka itu melainkan (dari kalangan) malaikat, (kerana merekalah sekuat-kuat dan sebenar-benar makhluk yang menjalankan perintah Kami); dan (hikmat) Kami tidak menerangkan bilangan mereka melainkan dengan satu bilangan yang menyebabkan kesesatan dan kesengsaraan orang-orang kafir itu, supaya orang-orang yang diberi Kitab (Yahudi dan Nasrani) boleh percaya dengan yakin (akan kebenaran Al-Quran), dan supaya orang-orang yang beriman bertambah imannya; dan juga supaya orang-orang yang diberi Kitab dan orang-orang yang beriman itu tidak ragu-ragu (tentang kebenaran keterangan itu); dan (sebaliknya) supaya orang-orang (munafik) yang ada penyakit (ragu-ragu) dalam hatinya dan orang-orang kafir berkata: \u201cApakah yang di maksudkan oleh Allah dengan menyebutkan bilangan ganjil ini?\u201d Demikianlah Allah menyesatkan sesiapa yang dikehendakiNya (menurut undang-undang peraturanNya), dan memberi hidayah petunjuk kepada sesiapa yang dikehendakiNya (menurut undang-undang peraturanNya); dan tiada yang mengetahui tentera Tuhanmu melainkan Dia lah sahaja. Dan (ingatlah, segala yang diterangkan berkenaan dengan) neraka itu tidak lain hanyalah menjadi peringatan bagi manusia.","footnotes":null},{"id":"5527","sura":"74","aya":"32","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u0650","translation":"Sebenarnya! Demi bulan,","footnotes":null},{"id":"5528","sura":"74","aya":"33","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u06e1 \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e","translation":"Dan malam apabila ia balik melenyapkan diri,","footnotes":null},{"id":"5529","sura":"74","aya":"34","arabic_text":"\u0648\u064e\u0671\u0644\u0635\u0651\u064f\u0628\u06e1\u062d\u0650 \u0625\u0650\u0630\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0641\u064e\u0631\u064e","translation":"Dan waktu subuh apabila ia terang-benderang,","footnotes":null},{"id":"5530","sura":"74","aya":"35","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u0644\u064e\u0625\u0650\u062d\u06e1\u062f\u064e\u0649 \u0671\u0644\u06e1\u0643\u064f\u0628\u064e\u0631\u0650","translation":"Sesungguhnya neraka Saqar itu adalah salah satu (malapetaka) yang amat besar,","footnotes":null},{"id":"5531","sura":"74","aya":"36","arabic_text":"\u0646\u064e\u0630\u0650\u064a\u0631\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"Yang menjadi amaran bagi umat manusia,","footnotes":null},{"id":"5532","sura":"74","aya":"37","arabic_text":"\u0644\u0650\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064e\u062a\u064e\u0642\u064e\u062f\u0651\u064e\u0645\u064e \u0623\u064e\u0648\u06e1 \u064a\u064e\u062a\u064e\u0623\u064e\u062e\u0651\u064e\u0631\u064e","translation":"(Iaitu) bagi sesiapa di antara kamu yang mahu maju (dalam mengerjakan kebaikan) atau yang mahu mundur (daripada mengerjakannya).","footnotes":null},{"id":"5533","sura":"74","aya":"38","arabic_text":"\u0643\u064f\u0644\u0651\u064f \u0646\u064e\u0641\u06e1\u0633\u0650\u06ed \u0628\u0650\u0645\u064e\u0627 \u0643\u064e\u0633\u064e\u0628\u064e\u062a\u06e1 \u0631\u064e\u0647\u0650\u064a\u0646\u064e\u0629\u064c","translation":"Tiap-tiap diri terikat, tidak terlepas daripada (balasan buruk bagi amal jahat) yang dikerjakannya,","footnotes":null},{"id":"5534","sura":"74","aya":"39","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"Kecuali puak Kanan,","footnotes":null},{"id":"5535","sura":"74","aya":"40","arabic_text":"\u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u064a\u064e\u062a\u064e\u0633\u064e\u0627\u0653\u0621\u064e\u0644\u064f\u0648\u0646\u064e","translation":"(Mereka ditempatkan) di dalam Syurga (yang penuh nikmat), mereka bertanya-tanya,","footnotes":null},{"id":"5536","sura":"74","aya":"41","arabic_text":"\u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e","translation":"Tentang (tempat tinggal) orang-orang yang bersalah,","footnotes":null},{"id":"5537","sura":"74","aya":"42","arabic_text":"\u0645\u064e\u0627 \u0633\u064e\u0644\u064e\u0643\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0633\u064e\u0642\u064e\u0631\u064e","translation":"(Setelah melihat orang-orang yang bersalah itu, mereka berkata): \u201cApakah yang menyebabkan kamu masuk ke dalam (neraka) Saqar?\u201d","footnotes":null},{"id":"5538","sura":"74","aya":"43","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0635\u064e\u0644\u0651\u0650\u064a\u0646\u064e","translation":"Orang-orang yang bersalah itu menjawab: \u201cKami tidak termasuk dalam kumpulan orang-orang yang mengerjakan sembahyang;","footnotes":null},{"id":"5539","sura":"74","aya":"44","arabic_text":"\u0648\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0646\u064f\u0637\u06e1\u0639\u0650\u0645\u064f \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u064e","translation":"\u201cDan kami tidak pernah memberi makan orang-orang miskin;","footnotes":null},{"id":"5540","sura":"74","aya":"45","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064e\u062e\u064f\u0648\u0636\u064f \u0645\u064e\u0639\u064e \u0671\u0644\u06e1\u062e\u064e\u0627\u0653\u0626\u0650\u0636\u0650\u064a\u0646\u064e","translation":"\u201cDan kami dahulu selalu mengambil bahagian memperkatakan perkara yang salah, bersama-sama orang-orang yang memperkatakannya;","footnotes":null},{"id":"5541","sura":"74","aya":"46","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"\u201cDan kami sentiasa mendustakan hari pembalasan,","footnotes":null},{"id":"5542","sura":"74","aya":"47","arabic_text":"\u062d\u064e\u062a\u0651\u064e\u0649\u0670\u0653 \u0623\u064e\u062a\u064e\u0649\u0670\u0646\u064e\u0627 \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u064f","translation":"\u201cSehinggalah kami didatangi oleh perkara yang tetap diyakini\u201d.","footnotes":null},{"id":"5543","sura":"74","aya":"48","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u062a\u064e\u0646\u0641\u064e\u0639\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u0629\u064f \u0671\u0644\u0634\u0651\u064e\u0670\u0641\u0650\u0639\u0650\u064a\u0646\u064e","translation":"Maka tidak akan berguna kepada mereka sebarang syafaat pertolongan (kalaulah ditakdirkan ada) sesiapa yang boleh memberikan syafaat itu.","footnotes":null},{"id":"5544","sura":"74","aya":"49","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0646\u0650 \u0671\u0644\u062a\u0651\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u0650 \u0645\u064f\u0639\u06e1\u0631\u0650\u0636\u0650\u064a\u0646\u064e","translation":"(Kalau demikianlah halnya orang-orang yang bersalah), maka mengapa mereka berpaling lari dari peringatan (Al-Quran)?","footnotes":null},{"id":"5545","sura":"74","aya":"50","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u062d\u064f\u0645\u064f\u0631\u065e \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0646\u0641\u0650\u0631\u064e\u0629\u065e","translation":"Seolah-olah mereka sekawan keldai liar yang lari,","footnotes":null},{"id":"5546","sura":"74","aya":"51","arabic_text":"\u0641\u064e\u0631\u0651\u064e\u062a\u06e1 \u0645\u0650\u0646 \u0642\u064e\u0633\u06e1\u0648\u064e\u0631\u064e\u0629\u0650\u06ed","translation":"Melarikan diri (ketakutan) dari singa!","footnotes":null},{"id":"5547","sura":"74","aya":"52","arabic_text":"\u0628\u064e\u0644\u06e1 \u064a\u064f\u0631\u0650\u064a\u062f\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u0624\u06e1\u062a\u064e\u0649\u0670 \u0635\u064f\u062d\u064f\u0641\u0657\u0627 \u0645\u0651\u064f\u0646\u064e\u0634\u0651\u064e\u0631\u064e\u0629\u0657","translation":"(Mereka tidak merasa cukup dengan peringatan itu) bahkan tiap-tiap seorang di antaranya mahu supaya diberi kepadanya lembaran surat yang terbuka (yang diturunkan dari langit untuk dibaca oleh mereka sendiri).","footnotes":null},{"id":"5548","sura":"74","aya":"53","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0628\u064e\u0644 \u0644\u0651\u064e\u0627 \u064a\u064e\u062e\u064e\u0627\u0641\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064e","translation":"Sebenarnya! (Bukan kerana kemahuan mereka tidak berhasil), bahkan mereka (tidak percaya dan) tidak takut akan hari akhirat.","footnotes":null},{"id":"5549","sura":"74","aya":"54","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e","translation":"Ketahuilah! Sesungguhnya Al-Quran itu adalah satu peringatan (yang sangat besar pengajarannya);","footnotes":null},{"id":"5550","sura":"74","aya":"55","arabic_text":"\u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Oleh itu sesiapa yang mahu (beringat) dapatlah ia mengambil peringatan daripadanya.","footnotes":null},{"id":"5551","sura":"74","aya":"56","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0630\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u062a\u0651\u064e\u0642\u06e1\u0648\u064e\u0649\u0670 \u0648\u064e\u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650","translation":"Dan (dalam pada itu) tiadalah mereka dapat beringat melainkan jika dikehendaki Allah; Dia lah Tuhan yang berhak dipatuhi perintahNya, dan Dia lah jua yang berhak memberi keampunan (kepada orang-orang yang beriman dan taat).","footnotes":null}]}