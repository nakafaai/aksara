{"result":[{"id":"5552","sura":"75","aya":"1","arabic_text":"\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u06e1\u0642\u0650\u064a\u064e\u0670\u0645\u064e\u0629\u0650","translation":"Aku bersumpah dengan Hari Kiamat;","footnotes":null},{"id":"5553","sura":"75","aya":"2","arabic_text":"\u0648\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0671\u0644\u0646\u0651\u064e\u0641\u06e1\u0633\u0650 \u0671\u0644\u0644\u0651\u064e\u0648\u0651\u064e\u0627\u0645\u064e\u0629\u0650","translation":"Dan Aku bersumpah dengan \u201cNafsul Lawwaamah\u201d (Bahawa kamu akan dibangkitkan sesudah mati)!","footnotes":null},{"id":"5554","sura":"75","aya":"3","arabic_text":"\u0623\u064e\u064a\u064e\u062d\u06e1\u0633\u064e\u0628\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0623\u064e\u0644\u0651\u064e\u0646 \u0646\u0651\u064e\u062c\u06e1\u0645\u064e\u0639\u064e \u0639\u0650\u0638\u064e\u0627\u0645\u064e\u0647\u064f\u06e5","translation":"Patutkah manusia (yang kafir) menyangka bahawa Kami tidak akan dapat mengumpulkan tulang-tulangnya (dan menghidupkannya semula)?","footnotes":null},{"id":"5555","sura":"75","aya":"4","arabic_text":"\u0628\u064e\u0644\u064e\u0649\u0670 \u0642\u064e\u0670\u062f\u0650\u0631\u0650\u064a\u0646\u064e \u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u0646\u0651\u064f\u0633\u064e\u0648\u0651\u0650\u064a\u064e \u0628\u064e\u0646\u064e\u0627\u0646\u064e\u0647\u064f\u06e5","translation":"Bukan sebagaimana yang disangka itu, bahkan Kami berkuasa menyusun (dengan sempurnanya segala tulang) jarinya, (tulang yang lebih halus dari yang lain).","footnotes":null},{"id":"5556","sura":"75","aya":"5","arabic_text":"\u0628\u064e\u0644\u06e1 \u064a\u064f\u0631\u0650\u064a\u062f\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0644\u0650\u064a\u064e\u0641\u06e1\u062c\u064f\u0631\u064e \u0623\u064e\u0645\u064e\u0627\u0645\u064e\u0647\u064f\u06e5","translation":"(Kebenaran itu bukan tidak ada buktinya), bahkan manusia (yang ingkar) sentiasa suka hendak meneruskan perbuatan kufur dan maksiat (di sepanjang hayatnya, sehingga ia tidak mengakui adanya hari kiamat).","footnotes":null},{"id":"5557","sura":"75","aya":"6","arabic_text":"\u064a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f \u0623\u064e\u064a\u0651\u064e\u0627\u0646\u064e \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u0642\u0650\u064a\u064e\u0670\u0645\u064e\u0629\u0650","translation":"Dia bertanya (secara mengejek): \u201cBilakah datangnya hari kiamat itu?\u201d","footnotes":null},{"id":"5558","sura":"75","aya":"7","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0628\u064e\u0631\u0650\u0642\u064e \u0671\u0644\u06e1\u0628\u064e\u0635\u064e\u0631\u064f","translation":"Maka (jawabnya: hari kiamat akan datang) apabila pemandangan menjadi terpendar-pendar (kerana gerun takut),","footnotes":null},{"id":"5559","sura":"75","aya":"8","arabic_text":"\u0648\u064e\u062e\u064e\u0633\u064e\u0641\u064e \u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u064f","translation":"Dan bulan hilang cahayanya,","footnotes":null},{"id":"5560","sura":"75","aya":"9","arabic_text":"\u0648\u064e\u062c\u064f\u0645\u0650\u0639\u064e \u0671\u0644\u0634\u0651\u064e\u0645\u06e1\u0633\u064f \u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u064f","translation":"Dan matahari serta bulan dihimpunkan bersama,","footnotes":null},{"id":"5561","sura":"75","aya":"10","arabic_text":"\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u064d \u0623\u064e\u064a\u06e1\u0646\u064e \u0671\u0644\u06e1\u0645\u064e\u0641\u064e\u0631\u0651\u064f","translation":"(Maka) pada hari itu, berkatalah manusia (yang ingkarkan hari kiamat): \u201cKe manakah hendak melarikan diri?\u201d","footnotes":null},{"id":"5562","sura":"75","aya":"11","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0644\u064e\u0627 \u0648\u064e\u0632\u064e\u0631\u064e","translation":"Tak usahlah bertanya demikian! Tidak ada lagi tempat perlindungan!","footnotes":null},{"id":"5563","sura":"75","aya":"12","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u064d \u0671\u0644\u06e1\u0645\u064f\u0633\u06e1\u062a\u064e\u0642\u064e\u0631\u0651\u064f","translation":"Pada hari itu, kepada Tuhanmu lah sahaja terserahnya ketetapan segala perkara.","footnotes":null},{"id":"5564","sura":"75","aya":"13","arabic_text":"\u064a\u064f\u0646\u064e\u0628\u0651\u064e\u0624\u064f\u0627\u0652 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0650\u06ed \u0628\u0650\u0645\u064e\u0627 \u0642\u064e\u062f\u0651\u064e\u0645\u064e \u0648\u064e\u0623\u064e\u062e\u0651\u064e\u0631\u064e","translation":"Pada hari itu, manusia diberitahu akan apa yang ia telah lakukan, dan apa yang ia telah tinggalkan.","footnotes":null},{"id":"5565","sura":"75","aya":"14","arabic_text":"\u0628\u064e\u0644\u0650 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0639\u064e\u0644\u064e\u0649\u0670 \u0646\u064e\u0641\u06e1\u0633\u0650\u0647\u0650\u06e6 \u0628\u064e\u0635\u0650\u064a\u0631\u064e\u0629\u065e","translation":"Bahkan manusia itu, (anggotanya) menjadi saksi terhadap dirinya sendiri,","footnotes":null},{"id":"5566","sura":"75","aya":"15","arabic_text":"\u0648\u064e\u0644\u064e\u0648\u06e1 \u0623\u064e\u0644\u06e1\u0642\u064e\u0649\u0670 \u0645\u064e\u0639\u064e\u0627\u0630\u0650\u064a\u0631\u064e\u0647\u064f\u06e5","translation":"Walaupun ia memberikan alasan-alasannya (untuk membela diri).","footnotes":null},{"id":"5567","sura":"75","aya":"16","arabic_text":"\u0644\u064e\u0627 \u062a\u064f\u062d\u064e\u0631\u0651\u0650\u0643\u06e1 \u0628\u0650\u0647\u0650\u06e6 \u0644\u0650\u0633\u064e\u0627\u0646\u064e\u0643\u064e \u0644\u0650\u062a\u064e\u0639\u06e1\u062c\u064e\u0644\u064e \u0628\u0650\u0647\u0650\u06e6\u0653","translation":"Janganlah engkau (wahai Muhammad) - Kerana hendakkan cepat menghafaz Quran yang diturunkan kepadamu - menggerakkan lidahmu membacanya (sebelum selesai dibacakan kepadamu).","footnotes":null},{"id":"5568","sura":"75","aya":"17","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u062c\u064e\u0645\u06e1\u0639\u064e\u0647\u064f\u06e5 \u0648\u064e\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064e\u0647\u064f\u06e5","translation":"Sesungguhnya Kamilah yang berkuasa mengumpulkan Al-Quran itu (dalam dadamu), dan menetapkan bacaannya (pada lidahmu);","footnotes":null},{"id":"5569","sura":"75","aya":"18","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u064e\u0631\u064e\u0623\u06e1\u0646\u064e\u0670\u0647\u064f \u0641\u064e\u0671\u062a\u0651\u064e\u0628\u0650\u0639\u06e1 \u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064e\u0647\u064f\u06e5","translation":"Oleh itu, apabila Kami telah menyempurnakan bacaannya (kepadamu, dengan perantaraan Jibril), maka bacalah menurut bacaannya itu;","footnotes":null},{"id":"5570","sura":"75","aya":"19","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u0628\u064e\u064a\u064e\u0627\u0646\u064e\u0647\u064f\u06e5","translation":"Kemudian, sesungguhnya kepada Kamilah terserah urusan menjelaskan kandungannya (yang memerlukan penjelasan).","footnotes":null},{"id":"5571","sura":"75","aya":"20","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0628\u064e\u0644\u06e1 \u062a\u064f\u062d\u0650\u0628\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0639\u064e\u0627\u062c\u0650\u0644\u064e\u0629\u064e","translation":"Sedarlah wahai orang-orang yang lalai. (Sebenarnya kamu tidak ingatkan kesudahan kamu) bahkan kamu sentiasa mencintai (Kesenangan dan kemewahan dunia) yang cepat habisnya.","footnotes":null},{"id":"5572","sura":"75","aya":"21","arabic_text":"\u0648\u064e\u062a\u064e\u0630\u064e\u0631\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064e","translation":"Dan kamu tidak menghiraukan (bekalan untuk) hari akhirat (yang kekal abadi kehidupannya).","footnotes":null},{"id":"5573","sura":"75","aya":"22","arabic_text":"\u0648\u064f\u062c\u064f\u0648\u0647\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0646\u0651\u064e\u0627\u0636\u0650\u0631\u064e\u0629\u064c","translation":"Pada hari akhirat itu, muka (orang-orang yang beriman) berseri-seri;","footnotes":null},{"id":"5574","sura":"75","aya":"23","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0647\u064e\u0627 \u0646\u064e\u0627\u0638\u0650\u0631\u064e\u0629\u065e","translation":"Melihat kepada Tuhannya.","footnotes":null},{"id":"5575","sura":"75","aya":"24","arabic_text":"\u0648\u064e\u0648\u064f\u062c\u064f\u0648\u0647\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0650\u06ed \u0628\u064e\u0627\u0633\u0650\u0631\u064e\u0629\u065e","translation":"Dan pada hari itu, muka (orang-orang kafir) muram hodoh,","footnotes":null},{"id":"5576","sura":"75","aya":"25","arabic_text":"\u062a\u064e\u0638\u064f\u0646\u0651\u064f \u0623\u064e\u0646 \u064a\u064f\u0641\u06e1\u0639\u064e\u0644\u064e \u0628\u0650\u0647\u064e\u0627 \u0641\u064e\u0627\u0642\u0650\u0631\u064e\u0629\u065e","translation":"Sambil percaya dengan yakin bahawa mereka akan ditimpa malapetaka (azab seksa) yang membinasakan.","footnotes":null},{"id":"5577","sura":"75","aya":"26","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0630\u064e\u0627 \u0628\u064e\u0644\u064e\u063a\u064e\u062a\u0650 \u0671\u0644\u062a\u0651\u064e\u0631\u064e\u0627\u0642\u0650\u064a\u064e","translation":"Sedarlah (janganlah mengutamakan dunia dan melupakan akhirat. Ingatlah akan hal orang yang hendak mati) apabila rohnya sampai ke pangkal kerongkong,","footnotes":null},{"id":"5578","sura":"75","aya":"27","arabic_text":"\u0648\u064e\u0642\u0650\u064a\u0644\u064e \u0645\u064e\u0646\u06e1\u06dc \u0631\u064e\u0627\u0642\u0656","translation":"Dan (orang-orang yang hadir di sisinya heboh) berkata: \u201cSiapakah yang dapat menawar jampi (dan mengubatnya)?\u201d","footnotes":null},{"id":"5579","sura":"75","aya":"28","arabic_text":"\u0648\u064e\u0638\u064e\u0646\u0651\u064e \u0623\u064e\u0646\u0651\u064e\u0647\u064f \u0671\u0644\u06e1\u0641\u0650\u0631\u064e\u0627\u0642\u064f","translation":"Dan ia sendiri yakin, bahawa sesungguhnya saat itu saat perpisahan;","footnotes":null},{"id":"5580","sura":"75","aya":"29","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u062a\u064e\u0641\u0651\u064e\u062a\u0650 \u0671\u0644\u0633\u0651\u064e\u0627\u0642\u064f \u0628\u0650\u0671\u0644\u0633\u0651\u064e\u0627\u0642\u0650","translation":"Serta kedahsyatan bertindih-tindih;","footnotes":null},{"id":"5581","sura":"75","aya":"30","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u064d \u0671\u0644\u06e1\u0645\u064e\u0633\u064e\u0627\u0642\u064f","translation":"(Maka) kepada Tuhanmulah - pada waktu itu - engkau dibawa (untuk menerima balasan).","footnotes":null},{"id":"5582","sura":"75","aya":"31","arabic_text":"\u0641\u064e\u0644\u064e\u0627 \u0635\u064e\u062f\u0651\u064e\u0642\u064e \u0648\u064e\u0644\u064e\u0627 \u0635\u064e\u0644\u0651\u064e\u0649\u0670","translation":"(Oleh sebab orang yang kufur ingkar tidak percayakan hari akhirat) maka ia tidak mengakui kebenaran (yang diwajibkan meyakininya) dan ia tidak mengerjakan sembahyang (yang difardhukan mengerjakannya)!","footnotes":null},{"id":"5583","sura":"75","aya":"32","arabic_text":"\u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646 \u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670","translation":"Akan tetapi ia mendustakan, dan berpaling ingkar!","footnotes":null},{"id":"5584","sura":"75","aya":"33","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0630\u064e\u0647\u064e\u0628\u064e \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u06e6 \u064a\u064e\u062a\u064e\u0645\u064e\u0637\u0651\u064e\u0649\u0670\u0653","translation":"Kemudian ia pergi kepada keluarganya dengan berlagak sombong megah.","footnotes":null},{"id":"5585","sura":"75","aya":"34","arabic_text":"\u0623\u064e\u0648\u06e1\u0644\u064e\u0649\u0670 \u0644\u064e\u0643\u064e \u0641\u064e\u0623\u064e\u0648\u06e1\u0644\u064e\u0649\u0670","translation":"(Wahai orang yang kufur ingkar!) sudahlah dekat kepadamu kebinasaanmu, sudahlah dekat!","footnotes":null},{"id":"5586","sura":"75","aya":"35","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0623\u064e\u0648\u06e1\u0644\u064e\u0649\u0670 \u0644\u064e\u0643\u064e \u0641\u064e\u0623\u064e\u0648\u06e1\u0644\u064e\u0649\u0670\u0653","translation":"Kemudian api nerakalah lebih layak bagimu, lebih layak.","footnotes":null},{"id":"5587","sura":"75","aya":"36","arabic_text":"\u0623\u064e\u064a\u064e\u062d\u06e1\u0633\u064e\u0628\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0623\u064e\u0646 \u064a\u064f\u062a\u06e1\u0631\u064e\u0643\u064e \u0633\u064f\u062f\u064b\u0649","translation":"Patutkah manusia menyangka, bahawa ia akan ditinggalkan terbiar (dengan tidak diberikan tanggungjawab dan tidak dihidupkan menerima balasan)?","footnotes":null},{"id":"5588","sura":"75","aya":"37","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u0643\u064f \u0646\u064f\u0637\u06e1\u0641\u064e\u0629\u0657 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0646\u0650\u064a\u0651\u0656 \u064a\u064f\u0645\u06e1\u0646\u064e\u0649\u0670","translation":"Bukankah ia berasal dari air mani yang dipancarkan (ke dalam rahim)?","footnotes":null},{"id":"5589","sura":"75","aya":"38","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0644\u064e\u0642\u064e\u0629\u0657 \u0641\u064e\u062e\u064e\u0644\u064e\u0642\u064e \u0641\u064e\u0633\u064e\u0648\u0651\u064e\u0649\u0670","translation":"Kemudian air mani itu menjadi sebuku darah beku, sesudah itu Tuhan menciptakannya, dan menyempurnakan kejadiannya (sebagai manusia)?","footnotes":null},{"id":"5590","sura":"75","aya":"39","arabic_text":"\u0641\u064e\u062c\u064e\u0639\u064e\u0644\u064e \u0645\u0650\u0646\u06e1\u0647\u064f \u0671\u0644\u0632\u0651\u064e\u0648\u06e1\u062c\u064e\u064a\u06e1\u0646\u0650 \u0671\u0644\u0630\u0651\u064e\u0643\u064e\u0631\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670\u0653","translation":"Lalu Tuhan menjadikan daripadanya dua jenis - lelaki dan perempuan.","footnotes":null},{"id":"5591","sura":"75","aya":"40","arabic_text":"\u0623\u064e\u0644\u064e\u064a\u06e1\u0633\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0628\u0650\u0642\u064e\u0670\u062f\u0650\u0631\u064d \u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u064a\u064f\u062d\u06e1\u0640\u06e7\u0650\u064a\u064e \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u062a\u064e\u0649\u0670","translation":"Adakah (Tuhan yang menjadikan semuanya) itu - tidak berkuasa menghidupkan orang-orang yang mati? (Tentulah berkuasa)!","footnotes":null}]}