{"result":[{"id":"5801","sura":"81","aya":"1","arabic_text":"\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0634\u0651\u064e\u0645\u06e1\u0633\u064f \u0643\u064f\u0648\u0651\u0650\u0631\u064e\u062a\u06e1","translation":"Apabila matahari dilingkari cahayanya (dan hilang lenyap);","footnotes":null},{"id":"5802","sura":"81","aya":"2","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0646\u0651\u064f\u062c\u064f\u0648\u0645\u064f \u0671\u0646\u0643\u064e\u062f\u064e\u0631\u064e\u062a\u06e1","translation":"Dan apabila bintang-bintang gugur berselerak;","footnotes":null},{"id":"5803","sura":"81","aya":"3","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u062c\u0650\u0628\u064e\u0627\u0644\u064f \u0633\u064f\u064a\u0651\u0650\u0631\u064e\u062a\u06e1","translation":"Dan apabila gunung-ganang di terbangkan ke angkasa (setelah dihancurkan menjadi debu);","footnotes":null},{"id":"5804","sura":"81","aya":"4","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u0639\u0650\u0634\u064e\u0627\u0631\u064f \u0639\u064f\u0637\u0651\u0650\u0644\u064e\u062a\u06e1","translation":"Dan apabila unta-unta yang bunting terbiar;","footnotes":null},{"id":"5805","sura":"81","aya":"5","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u0648\u064f\u062d\u064f\u0648\u0634\u064f \u062d\u064f\u0634\u0650\u0631\u064e\u062a\u06e1","translation":"Dan apabila binatang-binatang liar dihimpunkan;","footnotes":null},{"id":"5806","sura":"81","aya":"6","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u0628\u0650\u062d\u064e\u0627\u0631\u064f \u0633\u064f\u062c\u0651\u0650\u0631\u064e\u062a\u06e1","translation":"Dan apabila lautan meluap-luap bercampur-baur;","footnotes":null},{"id":"5807","sura":"81","aya":"7","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0646\u0651\u064f\u0641\u064f\u0648\u0633\u064f \u0632\u064f\u0648\u0651\u0650\u062c\u064e\u062a\u06e1","translation":"Dan apabila tiap-tiap diri disatukan dengan pasangannya;","footnotes":null},{"id":"5808","sura":"81","aya":"8","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u0621\u064f\u06e5\u062f\u064e\u0629\u064f \u0633\u064f\u0626\u0650\u0644\u064e\u062a\u06e1","translation":"Dan apabila anak perempuan yang ditanam hidup-hidup: ditanya, -","footnotes":null},{"id":"5809","sura":"81","aya":"9","arabic_text":"\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0630\u064e\u0646\u06e2\u0628\u0656 \u0642\u064f\u062a\u0650\u0644\u064e\u062a\u06e1","translation":"Dengan dosa apakah ia dibunuh?","footnotes":null},{"id":"5810","sura":"81","aya":"10","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0635\u0651\u064f\u062d\u064f\u0641\u064f \u0646\u064f\u0634\u0650\u0631\u064e\u062a\u06e1","translation":"Dan apabila surat-surat amal dibentangkan;","footnotes":null},{"id":"5811","sura":"81","aya":"11","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0643\u064f\u0634\u0650\u0637\u064e\u062a\u06e1","translation":"Dan apabila langit ditanggalkan dari tempatnya;","footnotes":null},{"id":"5812","sura":"81","aya":"12","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u062c\u064e\u062d\u0650\u064a\u0645\u064f \u0633\u064f\u0639\u0651\u0650\u0631\u064e\u062a\u06e1","translation":"Dan apabila neraka dinyalakan menjulang;","footnotes":null},{"id":"5813","sura":"81","aya":"13","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u062c\u064e\u0646\u0651\u064e\u0629\u064f \u0623\u064f\u0632\u06e1\u0644\u0650\u0641\u064e\u062a\u06e1","translation":"Dan apabila Syurga didekatkan;","footnotes":null},{"id":"5814","sura":"81","aya":"14","arabic_text":"\u0639\u064e\u0644\u0650\u0645\u064e\u062a\u06e1 \u0646\u064e\u0641\u06e1\u0633\u065e \u0645\u0651\u064e\u0627\u0653 \u0623\u064e\u062d\u06e1\u0636\u064e\u0631\u064e\u062a\u06e1","translation":"(Setelah semuanya itu berlaku), tiap-tiap orang akan mengetahui tentang amal yang telah dibawanya.","footnotes":null},{"id":"5815","sura":"81","aya":"15","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0671\u0644\u06e1\u062e\u064f\u0646\u0651\u064e\u0633\u0650","translation":"Oleh itu, Aku bersumpah dengan bintang-bintang yang tenggelam timbul;","footnotes":null},{"id":"5816","sura":"81","aya":"16","arabic_text":"\u0671\u0644\u06e1\u062c\u064e\u0648\u064e\u0627\u0631\u0650 \u0671\u0644\u06e1\u0643\u064f\u0646\u0651\u064e\u0633\u0650","translation":"Yang beredar, juga yang tetap pada tempatnya;","footnotes":null},{"id":"5817","sura":"81","aya":"17","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u064e\u0627 \u0639\u064e\u0633\u06e1\u0639\u064e\u0633\u064e","translation":"Dan malam, apabila ia hampir habis,","footnotes":null},{"id":"5818","sura":"81","aya":"18","arabic_text":"\u0648\u064e\u0671\u0644\u0635\u0651\u064f\u0628\u06e1\u062d\u0650 \u0625\u0650\u0630\u064e\u0627 \u062a\u064e\u0646\u064e\u0641\u0651\u064e\u0633\u064e","translation":"Dan siang, apabila ia mulai terang;","footnotes":null},{"id":"5819","sura":"81","aya":"19","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0648\u06e1\u0644\u064f \u0631\u064e\u0633\u064f\u0648\u0644\u0656 \u0643\u064e\u0631\u0650\u064a\u0645\u0656","translation":"Sebenarnya Al-Quran itu, sungguh-sungguh Kalamullah (yang disampaikan oleh Jibril) Utusan yang mulia,","footnotes":null},{"id":"5820","sura":"81","aya":"20","arabic_text":"\u0630\u0650\u064a \u0642\u064f\u0648\u0651\u064e\u0629\u064d \u0639\u0650\u0646\u062f\u064e \u0630\u0650\u064a \u0671\u0644\u06e1\u0639\u064e\u0631\u06e1\u0634\u0650 \u0645\u064e\u0643\u0650\u064a\u0646\u0656","translation":"Yang kuat gagah, lagi berkedudukan tinggi di sisi Allah yang mempunyai Arasy,","footnotes":null},{"id":"5821","sura":"81","aya":"21","arabic_text":"\u0645\u0651\u064f\u0637\u064e\u0627\u0639\u0656 \u062b\u064e\u0645\u0651\u064e \u0623\u064e\u0645\u0650\u064a\u0646\u0656","translation":"Yang ditaati di sana (dalam kalangan malaikat), lagi dipercayai.","footnotes":null},{"id":"5822","sura":"81","aya":"22","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0635\u064e\u0627\u062d\u0650\u0628\u064f\u0643\u064f\u0645 \u0628\u0650\u0645\u064e\u062c\u06e1\u0646\u064f\u0648\u0646\u0656","translation":"Dan sebenarnya sahabat kamu (Nabi Muhammad) itu (wahai golongan yang menentang Islam), bukanlah ia seorang gila (seperti yang kamu tuduh);","footnotes":null},{"id":"5823","sura":"81","aya":"23","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0631\u064e\u0621\u064e\u0627\u0647\u064f \u0628\u0650\u0671\u0644\u06e1\u0623\u064f\u0641\u064f\u0642\u0650 \u0671\u0644\u06e1\u0645\u064f\u0628\u0650\u064a\u0646\u0650","translation":"Dan (Nabi Muhammad yakin bahawa yang disampaikan kepadanya ialah wahyu dari Tuhan, kerana) demi sesungguhnya! Nabi Muhammad telah mengenal dan melihat Jibril di kaki langit yang nyata.","footnotes":null},{"id":"5824","sura":"81","aya":"24","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0628\u0650\u0636\u064e\u0646\u0650\u064a\u0646\u0656","translation":"Dan bukanlah Nabi Muhammad seorang yang boleh dituduh dan disangka buruk, terhadap penyampaiannya mengenai perkara-perkara yang ghaib.","footnotes":null},{"id":"5825","sura":"81","aya":"25","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0634\u064e\u064a\u06e1\u0637\u064e\u0670\u0646\u0656 \u0631\u0651\u064e\u062c\u0650\u064a\u0645\u0656","translation":"Dan sebenarnya Al-Quran itu bukanlah perkataan Syaitan yang kena rejam.","footnotes":null},{"id":"5826","sura":"81","aya":"26","arabic_text":"\u0641\u064e\u0623\u064e\u064a\u06e1\u0646\u064e \u062a\u064e\u0630\u06e1\u0647\u064e\u0628\u064f\u0648\u0646\u064e","translation":"(Dengan yang demikian) maka ke manakah kamu hendak pergi (kiranya kamu masih menyeleweng dari jalan Al-Quran)?","footnotes":null},{"id":"5827","sura":"81","aya":"27","arabic_text":"\u0625\u0650\u0646\u06e1 \u0647\u064f\u0648\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u065e \u0644\u0651\u0650\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"Al-Quran itu tidak lain hanyalah peringatan bagi seluruh penduduk alam:","footnotes":null},{"id":"5828","sura":"81","aya":"28","arabic_text":"\u0644\u0650\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064e\u0633\u06e1\u062a\u064e\u0642\u0650\u064a\u0645\u064e","translation":"Iaitu bagi sesiapa dari kamu yang mahu tetap teguh di atas jalan (Islam) yang betul.","footnotes":null},{"id":"5829","sura":"81","aya":"29","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u062a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0631\u064e\u0628\u0651\u064f \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"Dan kamu tidak dapat menentukan kemahuan kamu (mengenai sesuatupun), kecuali dengan cara yang diatur oleh Allah, Tuhan yang memelihara dan mentadbirkan seluruh alam.","footnotes":null}]}