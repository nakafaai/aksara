d":"5636","sura":"77","aya":"14","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u0641\u064e\u0635\u06e1\u0644\u0650","translation":"Dan apa jalannya engkau dapat mengetahui kedahsyatan hari pemutusan hukum itu?","footnotes":null},{"id":"5637","sura":"77","aya":"15","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Kecelakaan besar, pada hari itu, bagi orang-orang yang mendustakan (apa yang dijanjikan oleh Rasulnya)!","footnotes":null},{"id":"5638","sura":"77","aya":"16","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u0646\u064f\u0647\u06e1\u0644\u0650\u0643\u0650 \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e","translation":"Bukankah Kami telah binasakan orang-orang dahulu (yang ingkar derhaka, seperti kaum Nabi Nuh, Aad dan Thamud)?","footnotes":null},{"id":"5639","sura":"77","aya":"17","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0646\u064f\u062a\u06e1\u0628\u0650\u0639\u064f\u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u0650\u064a\u0646\u064e","translation":"Kemudian kami akan iringi mereka dengan (membinasakan orang-orang yang ingkar derhaka, dari) kaum-kaum yang datang kemudian.","footnotes":null},{"id":"5640","sura":"77","aya":"18","arabic_text":"\u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0646\u064e\u0641\u06e1\u0639\u064e\u0644\u064f \u0628\u0650\u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e","translation":"Demikian cara kami lakukan terhadap sesiapa yang berdosa.","footnotes":null},{"id":"5641","sura":"77","aya":"19","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Kecelakaan besar, pada hari itu, bagi orang-orang yang mendustakan (apa yang Kami janjikan)!","footnotes":null},{"id":"5642","sura":"77","aya":"20","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u062e\u06e1\u0644\u064f\u0642\u0643\u0651\u064f\u0645 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0627\u0653\u0621\u0656 \u0645\u0651\u064e\u0647\u0650\u064a\u0646\u0656","translation":"Bukankah Kami telah menciptakan kamu dari air (benih) yang sedikit dipandang orang?","footnotes":null},{"id":"5643","sura":"77","aya":"21","arabic_text":"\u0641\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f \u0641\u0650\u064a \u0642\u064e\u0631\u064e\u0627\u0631\u0656 \u0645\u0651\u064e\u0643\u0650\u064a\u0646\u064d","translation":"Lalu Kami jadikan air (benih) itu pada tempat penetapan yang kukuh,","footnotes":null},{"id":"5644","sura":"77","aya":"22","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0642\u064e\u062f\u064e\u0631\u0656 \u0645\u0651\u064e\u0639\u06e1\u0644\u064f\u0648\u0645\u0656","translation":"Hingga ke suatu masa yang termaklum?","footnotes":null},{"id":"5645","sura":"77","aya":"23","arabic_text":"\u0641\u064e\u0642\u064e\u062f\u064e\u0631\u06e1\u0646\u064e\u0627 \u0641\u064e\u0646\u0650\u0639\u06e1\u0645\u064e \u0671\u0644\u06e1\u0642\u064e\u0670\u062f\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Serta Kami tentukan (keadaannya), maka Kamilah sebaik-baik yang berkuasa menentukan dan melakukan (tiap-tiap sesuatu)!","footnotes":null},{"id":"5646","sura":"77","aya":"24","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Kecelakaan besar, pada hari itu, bagi orang-orang yang mendustakan (kekuasaan Kami)!","footnotes":null},{"id":"5647","sura":"77","aya":"25","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u062c\u06e1\u0639\u064e\u0644\u0650 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0643\u0650\u0641\u064e\u0627\u062a\u064b\u0627","translation":"Bukankah Kami telah menjadikan bumi (sebagai tempat) penampung dan penghimpun (penduduknya)? -","footnotes":null},{"id":"5648","sura":"77","aya":"26","arabic_text":"\u0623\u064e\u062d\u06e1\u064a\u064e\u0627\u0653\u0621\u0657 \u0648\u064e\u0623\u064e\u0645\u06e1\u0648\u064e\u0670\u062a\u0657\u0627","translation":"Yang hidup dan yang mati?","footnotes":null},{"id":"5649","sura":"77","aya":"27","arabic_text":"\u0648\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0641\u0650\u064a\u0647\u064e\u0627 \u0631\u064e\u0648\u064e\u0670\u0633\u0650\u064a\u064e \u0634\u064e\u0670\u0645\u0650\u062e\u064e\u0670\u062a\u0656 \u0648\u064e\u0623\u064e\u0633\u06e1\u0642\u064e\u064a\u06e1\u0646\u064e\u0670\u0643\u064f\u0645 \u0645\u0651\u064e\u0627\u0653\u0621\u0657 \u0641\u064f\u0631\u064e\u0627\u062a\u0657\u0627","translation":"Dan Kami telah jadikan di bumi: gunung-ganang yang menetapnya, yang tinggi menjulang; dan Kami telah memberi minum kepada kamu air yang tawar lagi memuaskan dahaga?","footnotes":null},{"id":"5650","sura":"77","aya":"28","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Kecelakaan besar, pada hari itu, bagi orang-orang yang mendustakan (nikmat-nikmat pemberian Kami)!","footnotes":null},{"id":"5651","sura":"77","aya":"29","arabic_text":"\u0671\u0646\u0637\u064e\u0644\u0650\u0642\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u064e\u0649\u0670 \u0645\u064e\u0627 \u0643\u064f\u0646\u062a\u064f\u0645 \u0628\u0650\u0647\u0650\u06e6 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"(Dikatakan kepada mereka semasa ditimpakan dengan azab): \u201cPergilah kepada azab yang dahulu kamu mendustakannya.","footnotes":null},{"id":"5652","sura":"77","aya":"30","arabic_text":"\u0671\u0646\u0637\u064e\u0644\u0650\u0642\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u064e\u0649\u0670 \u0638\u0650\u0644\u0651\u0656 \u0630\u0650\u064a \u062b\u064e\u0644\u064e\u0670\u062b\u0650 \u0634\u064f\u0639\u064e\u0628\u0656","translation":"\u201cPergilah kamu kepada naungan (asap neraka) yang bercabang tiga, -","footnotes":null},{"id":"5653","sura":"77","aya":"31","arabic_text":"\u0644\u0651\u064e\u0627 \u0638\u064e\u0644\u0650\u064a\u0644\u0656 \u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u063a\u06e1\u0646\u0650\u064a \u0645\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e\u0628\u0650","translation":"\u201cYang tidak dapat dijadikan naungan, dan tidak dapat memberikan sebarang lindungan dari julangan api neraka.","footnotes":null},{"id":"5654","sura":"77","aya":"32","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u062a\u064e\u0631\u06e1\u0645\u0650\u064a \u0628\u0650\u0634\u064e\u0631\u064e\u0631\u0656 \u0643\u064e\u0671\u0644\u06e1\u0642\u064e\u0635\u06e1\u0631\u0650","translation":"\u201cSesungguhnya neraka itu melemparkan bunga api, (yang besarnya) seperti bangunan besar,","footnotes":null},{"id":"5655","sura":"77","aya":"33","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u062c\u0650\u0645\u064e\u0670\u0644\u064e\u062a\u065e \u0635\u064f\u0641\u06e1\u0631\u065e","translation":"\u201c(Banyaknya dan warnanya) bunga api itu seolah-olah rombongan unta kuning\u201d.","footnotes":null},{"id":"5656","sura":"77","aya":"34","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Kecelakaan besar, pada hari itu, bagi orang-orang yang mendustakan (keadaan yang demikian).","footnotes":null},{"id":"5657","sura":"77","aya":"35","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0644\u064e\u0627 \u064a\u064e\u0646\u0637\u0650\u0642\u064f\u0648\u0646\u064e","translation":"Inilah hari mereka tidak dapat berkata-kata, (kerana masing-masing terpinga-pinga ketakutan),","footnotes":null},{"id":"5658","sura":"77","aya":"36","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0630\u064e\u0646\u064f \u0644\u064e\u0647\u064f\u0645\u06e1 \u0641\u064e\u064a\u064e\u0639\u06e1\u062a\u064e\u0630\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Dan tidak pula diizinkan mereka bercakap, maka mereka tidak dapat meminta maaf.","footnotes":null},{"id":"5659","sura":"77","aya":"37","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Kecelakaan besar, pada hari itu, bagi orang-orang yang mendustakan (hari akhirat)!","footnotes":null},{"id":"5660","sura":"77","aya":"38","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u0641\u064e\u0635\u06e1\u0644\u0650\u06d6 \u062c\u064e\u0645\u064e\u0639\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e","translation":"Inilah hari pemutusan hukum (yang menentukan siapa yang benar dan siapa yang salah). Kami himpunkan kamu bersama orang-orang yang terdahulu (dari kamu).","footnotes":null},{"id":"5661","sura":"77","aya":"39","arabic_text":"\u0641\u064e\u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0644\u064e\u0643\u064f\u0645\u06e1 \u0643\u064e\u064a\u06e1\u062f\u065e \u0641\u064e\u0643\u0650\u064a\u062f\u064f\u0648\u0646\u0650","translation":"Oleh itu, kalau kamu ada sebarang tipu-helah melepaskan diri, maka cubalah kamu lakukan terhadap azabKu.","footnotes":null},{"id":"5662","sura":"77","aya":"40","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Kecelakaan besar, pada hari itu, bagi orang-orang yang mendustakan (apa yang telah dijanjikan oleh Allah)!","footnotes":null},{"id":"5663","sura":"77","aya":"41","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0638\u0650\u0644\u064e\u0670\u0644\u0656 \u0648\u064e\u0639\u064f\u064a\u064f\u0648\u0646\u0656","translation":"Sesungguhnya orang-orang yang bertaqwa berada di tempat teduh (yang dipenuhi pelbagai nikmat), dan yang berdekatan dengan matair-matair (yang mengalir), -","footnotes":null},{"id":"5664","sura":"77","aya":"42","arabic_text":"\u0648\u064e\u0641\u064e\u0648\u064e\u0670\u0643\u0650\u0647\u064e \u0645\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0634\u06e1\u062a\u064e\u0647\u064f\u0648\u0646\u064e","translation":"Serta menikmati buah-buahan dari segala jenis yang mereka ingini.","footnotes":null},{"id":"5665","sura":"77","aya":"43","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u0671\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0627\u0652 \u0647\u064e\u0646\u0650\u064a\u0653\u0640\u0654\u064e\u06e2\u0627 \u0628\u0650\u0645\u064e\u0627 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0639\u06e1\u0645\u064e\u0644\u064f\u0648\u0646\u064e","translation":"(Pada ketika itu dikatakan kepada mereka): \u201cMakanlah dan minumlah kamu dengan lazatnya, disebabkan apa yang kamu telah kerjakan.\u201d","footnotes":null},{"id":"5666","sura":"77","aya":"44","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0646\u064e\u062c\u06e1\u0632\u0650\u064a \u0671\u0644\u06e1\u0645\u064f\u062d\u06e1\u0633\u0650\u0646\u0650\u064a\u0646\u064e","translation":"Sesungguhnya, demikianlah Kami membalas orang-orang yang berusaha mengerjakan amal-amal yang baik.","footnotes":null},{"id":"5667","sura":"77","aya":"45","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Kecelakaan besar, pada hari itu, bagi orang-orang yang mendustakan (nikmat-nikmat Syurga)!","footnotes":null},{"id":"5668","sura":"77","aya":"46","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u062a\u064e\u0645\u064e\u062a\u0651\u064e\u0639\u064f\u0648\u0627\u0652 \u0642\u064e\u0644\u0650\u064a\u0644\u064b\u0627 \u0625\u0650\u0646\u0651\u064e\u0643\u064f\u0645 \u0645\u0651\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e","translation":"Makanlah dan bersenang-senanglah kamu (wahai orang-orang yang ingkar derhaka) sementara waktu hidup, (kemudian kamu akan menghadapi bahaya), kerana sesungguhnya kamu adalah orang-orang yang berdosa.","footnotes":null},{"id":"5669","sura":"77","aya":"47","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Kecelakaan besar, pada hari itu, bagi orang-orang yang mendustakan (amaran Allah), -","footnotes":null},{"id":"5670","sura":"77","aya":"48","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u0650\u064a\u0644\u064e \u0644\u064e\u0647\u064f\u0645\u064f \u0671\u0631\u06e1\u0643\u064e\u0639\u064f\u0648\u0627\u0652 \u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u0643\u064e\u0639\u064f\u0648\u0646\u064e","translation":"Dan apabila dikatakan kepada mereka (yang ingkar): \u201cTaatlah dan kerjakanlah sembahyang\u201d, mereka enggan mengerjakannya.","footnotes":null},{"id":"5671","sura":"77","aya":"49","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Kecelakaan besar, pada hari itu, bagi orang-orang yang mendustakan (perintah-perintah Allah dan laranganNya)!","footnotes":null},{"id":"5672","sura":"77","aya":"50","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u062d\u064e\u062f\u0650\u064a\u062b\u0650\u06ed \u0628\u064e\u0639\u06e1\u062f\u064e\u0647\u064f\u06e5 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"(Kalau mereka tidak juga mahu beriman kepada keterangan-keterangan yang tersebut) maka kepada perkataan yang mana lagi, sesudah itu, mereka mahu beriman?","footnotes":null}]}