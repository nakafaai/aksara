{"result":[{"id":"5759","sura":"80","aya":"1","arabic_text":"\u0639\u064e\u0628\u064e\u0633\u064e \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670\u0653","translation":"Wajah Rasulullah -\u1e63allall\u0101hu 'alaihi wa sallam- menjadi masam dan beliau berpaling.","footnotes":null},{"id":"5760","sura":"80","aya":"2","arabic_text":"\u0623\u064e\u0646 \u062c\u064e\u0627\u0653\u0621\u064e\u0647\u064f \u0671\u0644\u06e1\u0623\u064e\u0639\u06e1\u0645\u064e\u0649\u0670","translation":"Hal itu karena beliau didatangi Abdullah bin Ummi Maktum, seorang yang buta, untuk meminta petunjuk dari beliau. Dia datang pada saat Rasulullah -\u1e63allall\u0101hu 'alaihi wa sallam- sedang sibuk dengan para pembesar kaum musyrikin karena berharap mereka bisa mendapat petunjuk.","footnotes":null},{"id":"5761","sura":"80","aya":"3","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064f\u062f\u06e1\u0631\u0650\u064a\u0643\u064e \u0644\u064e\u0639\u064e\u0644\u0651\u064e\u0647\u064f\u06e5 \u064a\u064e\u0632\u0651\u064e\u0643\u0651\u064e\u0649\u0670\u0653","translation":"Tahukah kamu -wahai Rasul- bisa jadi orang buta ini ingin membersihkan diri dari dosa-dosanya,","footnotes":null},{"id":"5762","sura":"80","aya":"4","arabic_text":"\u0623\u064e\u0648\u06e1 \u064a\u064e\u0630\u0651\u064e\u0643\u0651\u064e\u0631\u064f \u0641\u064e\u062a\u064e\u0646\u0641\u064e\u0639\u064e\u0647\u064f \u0671\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u064e\u0649\u0670\u0653","translation":"atau mengambil ibrah dari nasihat-nasihat yang didengarnya darimu lalu dia mendapatkan manfaat darinya?!","footnotes":null},{"id":"5763","sura":"80","aya":"5","arabic_text":"\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u0650 \u0671\u0633\u06e1\u062a\u064e\u063a\u06e1\u0646\u064e\u0649\u0670","translation":"Adapun orang yang merasa cukup dengan dirinya sendiri karena memiliki harta dibandingkan iman kepada apa yang engkau bawa,","footnotes":null},{"id":"5764","sura":"80","aya":"6","arabic_text":"\u0641\u064e\u0623\u064e\u0646\u062a\u064e \u0644\u064e\u0647\u064f\u06e5 \u062a\u064e\u0635\u064e\u062f\u0651\u064e\u0649\u0670","translation":"maka engkau melayaninya dan menemuinya.","footnotes":null},{"id":"5765","sura":"80","aya":"7","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064e \u0623\u064e\u0644\u0651\u064e\u0627 \u064a\u064e\u0632\u0651\u064e\u0643\u0651\u064e\u0649\u0670","translation":"Tidaklah engkau mendapatkan mudharat jika ia tidak mau bersuci dari dosa-dosanya dengan bertaubat kepada Allah.","footnotes":null},{"id":"5766","sura":"80","aya":"8","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646 \u062c\u064e\u0627\u0653\u0621\u064e\u0643\u064e \u064a\u064e\u0633\u06e1\u0639\u064e\u0649\u0670","translation":"Adapun orang yang bersegera datang kepadamu untuk mencari kebaikan,","footnotes":null},{"id":"5767","sura":"80","aya":"9","arabic_text":"\u0648\u064e\u0647\u064f\u0648\u064e \u064a\u064e\u062e\u06e1\u0634\u064e\u0649\u0670","translation":"sembari merasa takut kepada Tuhannya,","footnotes":null},{"id":"5768","sura":"80","aya":"10","arabic_text":"\u0641\u064e\u0623\u064e\u0646\u062a\u064e \u0639\u064e\u0646\u06e1\u0647\u064f \u062a\u064e\u0644\u064e\u0647\u0651\u064e\u0649\u0670","translation":"justru engkau mengabaikannya karena sibuk dengan pembesar-pembesar kaum musyrikin.","footnotes":null},{"id":"5769","sura":"80","aya":"11","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e","translation":"\u00a0Seharusnya tidak demikian, sesungguhnya ajaran agama itu adalah nasehat dan peringatan bagi orang yang menerimanya.","footnotes":null},{"id":"5770","sura":"80","aya":"12","arabic_text":"\u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Barang siapa ingin mengingat Allah maka dia mengingat Allah dan mendapat pelajaran dari apa yang ada di dalam Al-Qur`\u0101n ini.","footnotes":null},{"id":"5771","sura":"80","aya":"13","arabic_text":"\u0641\u0650\u064a \u0635\u064f\u062d\u064f\u0641\u0656 \u0645\u0651\u064f\u0643\u064e\u0631\u0651\u064e\u0645\u064e\u0629\u0656","translation":"Al-Qur`\u0101n ini berada di lembaran-lembaran mulia yang ada pada para malaikat.","footnotes":null},{"id":"5772","sura":"80","aya":"14","arabic_text":"\u0645\u0651\u064e\u0631\u06e1\u0641\u064f\u0648\u0639\u064e\u0629\u0656 \u0645\u0651\u064f\u0637\u064e\u0647\u0651\u064e\u0631\u064e\u0629\u0650\u06ed","translation":"Ia ditinggikan di tempat yang tinggi, lagi suci, tidak ada kotoran maupun noda yang mengenainya.","footnotes":null},{"id":"5773","sura":"80","aya":"15","arabic_text":"\u0628\u0650\u0623\u064e\u064a\u06e1\u062f\u0650\u064a \u0633\u064e\u0641\u064e\u0631\u064e\u0629\u0656","translation":"Dia berada di tangan para utusan dari golongan malaikat.","footnotes":null},{"id":"5774","sura":"80","aya":"16","arabic_text":"\u0643\u0650\u0631\u064e\u0627\u0645\u0650\u06ed \u0628\u064e\u0631\u064e\u0631\u064e\u0629\u0656","translation":"Mereka mulia di sisi Tuhan mereka, banyak melakukan amal kebaikan dan ketaatan.","footnotes":null},{"id":"5775","sura":"80","aya":"17","arabic_text":"\u0642\u064f\u062a\u0650\u0644\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0645\u064e\u0627\u0653 \u0623\u064e\u0643\u06e1\u0641\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Terlaknatlah manusia yang kafir, betapa besar kekafirannya terhadap Allah!","footnotes":null},{"id":"5776","sura":"80","aya":"18","arabic_text":"\u0645\u0650\u0646\u06e1 \u0623\u064e\u064a\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u064d \u062e\u064e\u0644\u064e\u0642\u064e\u0647\u064f\u06e5","translation":"Dari apa Allah menciptakannya sehingga ia berbuat kesombongan di bumi dan mengingkari Allah?","footnotes":null},{"id":"5777","sura":"80","aya":"19","arabic_text":"\u0645\u0650\u0646 \u0646\u0651\u064f\u0637\u06e1\u0641\u064e\u0629\u064d \u062e\u064e\u0644\u064e\u0642\u064e\u0647\u064f\u06e5 \u0641\u064e\u0642\u064e\u062f\u0651\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Allah menciptakannya dari air yang sedikit, lalu Dia menakdirkan penciptaannya fase demi fase.","footnotes":null},{"id":"5778","sura":"80","aya":"20","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0671\u0644\u0633\u0651\u064e\u0628\u0650\u064a\u0644\u064e \u064a\u064e\u0633\u0651\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Kemudian setelah berbagai fase ini Allah memudahkan baginya untuk keluar dari perut ibunya.","footnotes":null},{"id":"5779","sura":"80","aya":"21","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0623\u064e\u0645\u064e\u0627\u062a\u064e\u0647\u064f\u06e5 \u0641\u064e\u0623\u064e\u0642\u06e1\u0628\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Kemudian setelah Allah menentukan baginya umur kehidupannya, Allah mematikannya dan menjadikan baginya kuburan sebagai tempatnya hingga ia dibangkitkan.","footnotes":null},{"id":"5780","sura":"80","aya":"22","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0630\u064e\u0627 \u0634\u064e\u0627\u0653\u0621\u064e \u0623\u064e\u0646\u0634\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Kemudian jika Allah berkehendak untuk membangkitkannya untuk perhitungan dan pembalasan, maka Allah membangkitkannya.","footnotes":null},{"id":"5781","sura":"80","aya":"23","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0644\u064e\u0645\u0651\u064e\u0627 \u064a\u064e\u0642\u06e1\u0636\u0650 \u0645\u064e\u0627\u0653 \u0623\u064e\u0645\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Tidaklah perkaranya seperti yang disangka oleh orang kafir ini bahwa ia telah menunaikan kewajibannya terhadap Tuhannya, padahal ia tidak menjalankan kewajiban-kewajiban yang telah Allah wajibkan atasnya.","footnotes":null},{"id":"5782","sura":"80","aya":"24","arabic_text":"\u0641\u064e\u0644\u06e1\u064a\u064e\u0646\u0638\u064f\u0631\u0650 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0625\u0650\u0644\u064e\u0649\u0670 \u0637\u064e\u0639\u064e\u0627\u0645\u0650\u0647\u0650\u06e6\u0653","translation":"Hendaknya orang yang kafir terhadap Allah itu melihat kepada makanannya, bagaimana ia mendapatkannya?","footnotes":null},{"id":"5783","sura":"80","aya":"25","arabic_text":"\u0623\u064e\u0646\u0651\u064e\u0627 \u0635\u064e\u0628\u064e\u0628\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0645\u064e\u0627\u0653\u0621\u064e \u0635\u064e\u0628\u0651\u0657\u0627","translation":"Asalnya adalah Kami mencurahkan air dari langit dengan menurunkan hujan.","footnotes":null},{"id":"5784","sura":"80","aya":"26","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0634\u064e\u0642\u064e\u0642\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0634\u064e\u0642\u0651\u0657\u0627","translation":"Kemudian Kami belah tanah sehingga tanah terbelah untuk tumbuh-tumbuhan.","footnotes":null},{"id":"5785","sura":"80","aya":"27","arabic_text":"\u0641\u064e\u0623\u064e\u0646\u06e2\u0628\u064e\u062a\u06e1\u0646\u064e\u0627 \u0641\u0650\u064a\u0647\u064e\u0627 \u062d\u064e\u0628\u0651\u0657\u0627","translation":"Lalu Kami tumbuhkan padanya biji-bijian dari gandum dan tanaman berbiji dan lain-lainnya.","footnotes":null},{"id":"5786","sura":"80","aya":"28","arabic_text":"\u0648\u064e\u0639\u0650\u0646\u064e\u0628\u0657\u0627 \u0648\u064e\u0642\u064e\u0636\u06e1\u0628\u0657\u0627","translation":"Kami menumbuhkan padanya anggur dan rerumputan basah sebagai makanan ternak mereka.","footnotes":null},{"id":"5787","sura":"80","aya":"29","arabic_text":"\u0648\u064e\u0632\u064e\u064a\u06e1\u062a\u064f\u0648\u0646\u0657\u0627 \u0648\u064e\u0646\u064e\u062e\u06e1\u0644\u0657\u0627","translation":"Kami tumbuhkan padanya pohon zaitun dan kurma.","footnotes":null},{"id":"5788","sura":"80","aya":"30","arabic_text":"\u0648\u064e\u062d\u064e\u062f\u064e\u0627\u0653\u0626\u0650\u0642\u064e \u063a\u064f\u0644\u06e1\u0628\u0657\u0627","translation":"Kami tumbuhkan padanya berbagai kebun yang banyak pepohonannya.","footnotes":null},{"id":"5789","sura":"80","aya":"31","arabic_text":"\u0648\u064e\u0641\u064e\u0670\u0643\u0650\u0647\u064e\u0629\u0657 \u0648\u064e\u0623\u064e\u0628\u0651\u0657\u0627","translation":"Kami juga menumbuhkan padanya buah-buahan serta segala yang menjadi makanan hewan ternak kalian.","footnotes":null},{"id":"5790","sura":"80","aya":"32","arabic_text":"\u0645\u0651\u064e\u062a\u064e\u0670\u0639\u0657\u0627 \u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u0644\u0650\u0623\u064e\u0646\u06e1\u0639\u064e\u0670\u0645\u0650\u0643\u064f\u0645\u06e1","translation":"Semua itu bertujuan agar kalian dan hewan ternak kalian memanfaatkannya.","footnotes":null},{"id":"5791","sura":"80","aya":"33","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u062c\u064e\u0627\u0653\u0621\u064e\u062a\u0650 \u0671\u0644\u0635\u0651\u064e\u0627\u0653\u062e\u0651\u064e\u0629\u064f","translation":"Lalu jika tiba suara dahsyat yang memekakkan telinga, yaitu tiupan sangkakala kedua,","footnotes":null},{"id":"5792","sura":"80","aya":"34","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0641\u0650\u0631\u0651\u064f \u0671\u0644\u06e1\u0645\u064e\u0631\u06e1\u0621\u064f \u0645\u0650\u0646\u06e1 \u0623\u064e\u062e\u0650\u064a\u0647\u0650","translation":"pada hari itu seseorang lari dari saudaranya,","footnotes":null},{"id":"5793","sura":"80","aya":"35","arabic_text":"\u0648\u064e\u0623\u064f\u0645\u0651\u0650\u0647\u0650\u06e6 \u0648\u064e\u0623\u064e\u0628\u0650\u064a\u0647\u0650","translation":"juga lari dari ibu dan bapaknya,","footnotes":null},{"id":"5794","sura":"80","aya":"36","arabic_text":"\u0648\u064e\u0635\u064e\u0670\u062d\u0650\u0628\u064e\u062a\u0650\u0647\u0650\u06e6 \u0648\u064e\u0628\u064e\u0646\u0650\u064a\u0647\u0650","translation":"\u00a0dan lari dari istri dan anak-anaknya.","footnotes":null},{"id":"5795","sura":"80","aya":"37","arabic_text":"\u0644\u0650\u0643\u064f\u0644\u0651\u0650 \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0634\u064e\u0623\u06e1\u0646\u065e \u064a\u064f\u063a\u06e1\u0646\u0650\u064a\u0647\u0650","translation":"\u00a0Masing-masing saat itu mempunyai perkara yang menjadikannya lupa terhadap orang lain karena dahsyatnya kesulitan pada hari itu.","footnotes":null},{"id":"5796","sura":"80","aya":"38","arabic_text":"\u0648\u064f\u062c\u064f\u0648\u0647\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0645\u0651\u064f\u0633\u06e1\u0641\u0650\u0631\u064e\u0629\u065e","translation":"Wajah-wajah orang yang bahagia pada hari itu tampak bersinar.","footnotes":null},{"id":"5797","sura":"80","aya":"39","arabic_text":"\u0636\u064e\u0627\u062d\u0650\u0643\u064e\u0629\u065e \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0628\u06e1\u0634\u0650\u0631\u064e\u0629\u065e","translation":"Wajah-wajah itu tertawa gembira dengan apa yang telah disediakan oleh Allah dari rahmat-Nya.","footnotes":null},{"id":"5798","sura":"80","aya":"40","arabic_text":"\u0648\u064e\u0648\u064f\u062c\u064f\u0648\u0647\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u064d \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u064e\u0627 \u063a\u064e\u0628\u064e\u0631\u064e\u0629\u065e","translation":"\u00a0Sebaliknya, wajah-wajah orang kafir pada hari itu tertutup debu.","footnotes":null},{"id":"5799","sura":"80","aya":"41","arabic_text":"\u062a\u064e\u0631\u06e1\u0647\u064e\u0642\u064f\u0647\u064e\u0627 \u0642\u064e\u062a\u064e\u0631\u064e\u0629\u064c","translation":"Wajah-wajah itu tertutupi oleh kegelapan.","footnotes":null},{"id":"5800","sura":"80","aya":"42","arabic_text":"\u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u0643\u064e\u0641\u064e\u0631\u064e\u0629\u064f \u0671\u0644\u06e1\u0641\u064e\u062c\u064e\u0631\u064e\u0629\u064f","translation":"Orang-orang yang disebutkan dengan ciri-ciri demikian itu adalah orang-orang yang telah menggabungkan antara kekafiran dan kedurhakaan.","footnotes":null}]}