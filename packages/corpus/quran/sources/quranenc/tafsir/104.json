{"result":[{"id":"6180","sura":"104","aya":"1","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u0644\u0651\u0650\u0643\u064f\u0644\u0651\u0650 \u0647\u064f\u0645\u064e\u0632\u064e\u0629\u0656 \u0644\u0651\u064f\u0645\u064e\u0632\u064e\u0629\u064d","translation":"\u00a0Celaka dan siksa yang pedih bagi orang yang banyak menggunjing manusia dan mencela mereka.","footnotes":null},{"id":"6181","sura":"104","aya":"2","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062c\u064e\u0645\u064e\u0639\u064e \u0645\u064e\u0627\u0644\u0657\u0627 \u0648\u064e\u0639\u064e\u062f\u0651\u064e\u062f\u064e\u0647\u064f\u06e5","translation":"Yaitu orang yang tujuannya hanya mengumpulkan harta dan menghitung-hitungnya, ia tidak mempunyai tujuan lagi selain itu.","footnotes":null},{"id":"6182","sura":"104","aya":"3","arabic_text":"\u064a\u064e\u062d\u06e1\u0633\u064e\u0628\u064f \u0623\u064e\u0646\u0651\u064e \u0645\u064e\u0627\u0644\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u062e\u06e1\u0644\u064e\u062f\u064e\u0647\u064f\u06e5","translation":"Ia mengira bahwa harta yang dikumpulkannya bisa menolongnya dari kematian sehingga ia bisa hidup kekal di kehidupan dunia.","footnotes":null},{"id":"6183","sura":"104","aya":"4","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0644\u064e\u064a\u064f\u0646\u06e2\u0628\u064e\u0630\u064e\u0646\u0651\u064e \u0641\u0650\u064a \u0671\u0644\u06e1\u062d\u064f\u0637\u064e\u0645\u064e\u0629\u0650","translation":"Urusannya tidak sebagaimana yang dibayangkan oleh orang bodoh ini. Sungguh ia akan dilemparkan ke dalam neraka Jahanam yang menghanguskan dan menghancurkan segala sesuatu yang dilemparkan ke dalamnya karena dahsyatnya kekuatannya.","footnotes":null},{"id":"6184","sura":"104","aya":"5","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u0671\u0644\u06e1\u062d\u064f\u0637\u064e\u0645\u064e\u0629\u064f","translation":"Tahukah kamu -wahai Rasul- apakah neraka yang menghancurkan segala yang dilemparkan ke dalamnya ini?!","footnotes":null},{"id":"6185","sura":"104","aya":"6","arabic_text":"\u0646\u064e\u0627\u0631\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u06e1\u0645\u064f\u0648\u0642\u064e\u062f\u064e\u0629\u064f","translation":"Itulah neraka Allah yang menyala-nyala.","footnotes":null},{"id":"6186","sura":"104","aya":"7","arabic_text":"\u0671\u0644\u0651\u064e\u062a\u0650\u064a \u062a\u064e\u0637\u0651\u064e\u0644\u0650\u0639\u064f \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0623\u064e\u0641\u06e1\u0640\u0654\u0650\u062f\u064e\u0629\u0650","translation":"Ia yang membakar tubuh manusia hingga tembus ke jantung mereka.","footnotes":null},{"id":"6187","sura":"104","aya":"8","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645 \u0645\u0651\u064f\u0624\u06e1\u0635\u064e\u062f\u064e\u0629\u065e","translation":"Sesungguhnya neraka itu tertutup bagi orang-orang yang mendapatkan siksa di dalamnya.","footnotes":null},{"id":"6188","sura":"104","aya":"9","arabic_text":"\u0641\u0650\u064a \u0639\u064e\u0645\u064e\u062f\u0656 \u0645\u0651\u064f\u0645\u064e\u062f\u0651\u064e\u062f\u064e\u0629\u0650\u06ed","translation":"Mereka diikat pada tiang-tiang yang panjang sehingga mereka tidak bisa keluar darinya.","footnotes":null}]}