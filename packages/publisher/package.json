{
  "name": "@nakafa/aksara-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#publisher/*": {
      "aksara-source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#test/*": "./test/*.ts"
  },
  "exports": {
    "./accept": {
      "aksara-source": "./src/accept.ts",
      "types": "./dist/accept.d.ts",
      "import": "./dist/accept.js"
    },
    "./abort": {
      "aksara-source": "./src/abort.ts",
      "types": "./dist/abort.d.ts",
      "import": "./dist/abort.js"
    },
    "./catalog/publication": {
      "aksara-source": "./src/catalog/publication.ts",
      "types": "./dist/catalog/publication.d.ts",
      "import": "./dist/catalog/publication.js"
    },
    "./catalog/validation": {
      "aksara-source": "./src/catalog/validation.ts",
      "types": "./dist/catalog/validation.d.ts",
      "import": "./dist/catalog/validation.js"
    },
    "./cleanup": {
      "aksara-source": "./src/cleanup.ts",
      "types": "./dist/cleanup.d.ts",
      "import": "./dist/cleanup.js"
    },
    "./git/source": {
      "aksara-source": "./src/git/source.ts",
      "types": "./dist/git/source.d.ts",
      "import": "./dist/git/source.js"
    },
    "./heads": {
      "aksara-source": "./src/heads.ts",
      "types": "./dist/heads.d.ts",
      "import": "./dist/heads.js"
    },
    "./preparation": {
      "aksara-source": "./src/preparation.ts",
      "types": "./dist/preparation.d.ts",
      "import": "./dist/preparation.js"
    },
    "./preparation/recovery": {
      "aksara-source": "./src/preparation/recovery.ts",
      "types": "./dist/preparation/recovery.d.ts",
      "import": "./dist/preparation/recovery.js"
    },
    "./preview/source": {
      "aksara-source": "./src/preview/source.ts",
      "types": "./dist/preview/source.d.ts",
      "import": "./dist/preview/source.js"
    },
    "./publication": {
      "aksara-source": "./src/publication.ts",
      "types": "./dist/publication.d.ts",
      "import": "./dist/publication.js"
    },
    "./publication/spec": {
      "aksara-source": "./src/publication/spec.ts",
      "types": "./dist/publication/spec.d.ts",
      "import": "./dist/publication/spec.js"
    },
    "./release-validation": {
      "aksara-source": "./src/release-validation.ts",
      "types": "./dist/release-validation.d.ts",
      "import": "./dist/release-validation.js"
    },
    "./recover": {
      "aksara-source": "./src/recover.ts",
      "types": "./dist/recover.d.ts",
      "import": "./dist/recover.js"
    },
    "./rollback": {
      "aksara-source": "./src/rollback.ts",
      "types": "./dist/rollback.d.ts",
      "import": "./dist/rollback.js"
    },
    "./resume": {
      "aksara-source": "./src/resume.ts",
      "types": "./dist/resume.d.ts",
      "import": "./dist/resume.js"
    },
    "./signing/service": {
      "aksara-source": "./src/signing/service.ts",
      "types": "./dist/signing/service.d.ts",
      "import": "./dist/signing/service.js"
    },
    "./signing/error": {
      "aksara-source": "./src/signing/error.ts",
      "types": "./dist/signing/error.d.ts",
      "import": "./dist/signing/error.js"
    },
    "./snapshot/release": {
      "aksara-source": "./src/snapshot/release.ts",
      "types": "./dist/snapshot/release.d.ts",
      "import": "./dist/snapshot/release.js"
    },
    "./target/errors": {
      "aksara-source": "./src/target/errors.ts",
      "types": "./dist/target/errors.d.ts",
      "import": "./dist/target/errors.js"
    },
    "./target/http": {
      "aksara-source": "./src/target/http.ts",
      "types": "./dist/target/http.d.ts",
      "import": "./dist/target/http.js"
    }
  },
  "scripts": {
    "clean": "git clean -xdf dist coverage",
    "prebuild": "git clean -xdf dist",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@nakafa/aksara-compiler": "workspace:*",
    "@nakafa/aksara-contracts": "workspace:*",
    "@nakafa/aksara-corpus": "workspace:*",
    "@nakafa/aksara-utilities": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@nakafa/testing": "workspace:*",
    "@nakafa/typescript-config": "workspace:*",
    "@vitest/coverage-istanbul": "catalog:",
    "vitest": "catalog:"
  }
}
