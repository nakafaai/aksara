{
  "name": "@nakafa/aksara-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#compiler/*": {
      "aksara-source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    "./assessment/document": {
      "aksara-source": "./src/assessment/document.ts",
      "types": "./dist/assessment/document.d.ts",
      "import": "./dist/assessment/document.js"
    },
    "./assessment/error": {
      "aksara-source": "./src/assessment/error.ts",
      "types": "./dist/assessment/error.d.ts",
      "import": "./dist/assessment/error.js"
    },
    "./assessment/label": {
      "aksara-source": "./src/assessment/label.ts",
      "types": "./dist/assessment/label.d.ts",
      "import": "./dist/assessment/label.js"
    },
    "./compile": {
      "aksara-source": "./src/compile.ts",
      "types": "./dist/compile.d.ts",
      "import": "./dist/compile.js"
    },
    "./errors": {
      "aksara-source": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./incremental": {
      "aksara-source": "./src/incremental.ts",
      "types": "./dist/incremental.d.ts",
      "import": "./dist/incremental.js"
    },
    "./inspect": {
      "aksara-source": "./src/inspect.ts",
      "types": "./dist/inspect.d.ts",
      "import": "./dist/inspect.js"
    }
  },
  "scripts": {
    "clean": "git clean -xdf dist coverage",
    "prebuild": "git clean -xdf dist",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@mdx-js/mdx": "catalog:",
    "@nakafa/aksara-contracts": "workspace:*",
    "effect": "catalog:",
    "eslint-scope": "catalog:",
    "estree-util-visit": "catalog:",
    "mdast-util-to-string": "catalog:",
    "remark-gfm": "catalog:",
    "remark-math": "catalog:",
    "remark-parse": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@nakafa/testing": "workspace:*",
    "@nakafa/typescript-config": "workspace:*",
    "@types/estree-jsx": "catalog:",
    "@types/mdast": "catalog:",
    "@types/unist": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "mdast-util-mdx": "catalog:",
    "vitest": "catalog:"
  }
}
