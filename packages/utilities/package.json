{
  "name": "@nakafa/aksara-utilities",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#utilities/*": {
      "aksara-source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    "./git/exact": {
      "aksara-source": "./src/git/exact.ts",
      "types": "./dist/git/exact.d.ts",
      "import": "./dist/git/exact.js"
    },
    "./http/response": {
      "aksara-source": "./src/http/response.ts",
      "types": "./dist/http/response.d.ts",
      "import": "./dist/http/response.js"
    },
    "./process/exact": {
      "aksara-source": "./src/process/exact.ts",
      "types": "./dist/process/exact.d.ts",
      "import": "./dist/process/exact.js"
    },
    "./process/group": {
      "aksara-source": "./src/process/group.ts",
      "types": "./dist/process/group.d.ts",
      "import": "./dist/process/group.js"
    },
    "./typescript/syntax": {
      "aksara-source": "./src/typescript/syntax.ts",
      "types": "./dist/typescript/syntax.d.ts",
      "import": "./dist/typescript/syntax.js"
    }
  },
  "scripts": {
    "clean": "git clean -xdf dist coverage",
    "prebuild": "git clean -xdf dist",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@nakafa/testing": "workspace:*",
    "@nakafa/typescript-config": "workspace:*",
    "@vitest/coverage-istanbul": "catalog:",
    "vitest": "catalog:"
  }
}
