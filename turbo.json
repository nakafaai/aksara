{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "envMode": "strict",
  "globalDependencies": ["packages/typescript-config/*.json"],
  "tasks": {
    "//#clean:root": {
      "cache": false
    },
    "//#test:lesson-voice": {
      "inputs": [
        "package.json",
        ".agents/skills/nakafa-content/SKILL.md",
        ".agents/skills/nakafa-content/references/**/*.md",
        ".agents/skills/nakafa-content/scripts/**/*.ts",
        "scripts/voice.config.ts",
        "packages/testing/index.ts",
        "packages/contracts/package.json",
        "packages/contracts/src/locale.ts",
        "packages/contracts/src/text/syntax.ts",
        "packages/corpus/material/lesson/**/*.mdx",
        "packages/corpus/articles/**/*.mdx",
        "packages/corpus/question-bank/**/*.mdx"
      ],
      "outputs": ["coverage/voice/**"]
    },
    "//#test:root": {
      "dependsOn": [
        "//#test:lesson-voice",
        "@nakafa/aksara-contracts#build",
        "@nakafa/aksara-utilities#build"
      ],
      "inputs": [
        "package.json",
        "scripts/**/*.ts",
        "packages/testing/index.ts"
      ],
      "outputs": ["coverage/**"]
    },
    "//#typecheck:root": {
      "inputs": [
        "tsconfig.json",
        ".agents/skills/nakafa-content/scripts/**/*.ts",
        "scripts/**/*.ts",
        "apps/*/vitest.config.ts",
        "packages/*/vitest.config.ts",
        "packages/*/scripts/**/*.ts",
        "packages/*/package.json"
      ],
      "outputs": [],
      "dependsOn": [
        "@nakafa/aksara-contracts#transit",
        "@nakafa/aksara-utilities#transit"
      ]
    },
    "@nakafa/aksara-contracts#test": {
      "dependsOn": ["//#test:root", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/testing/index.ts"],
      "outputs": ["coverage/**"]
    },
    "@nakafa/aksara-corpus#build": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@nakafa/aksara-corpus#test": {
      "cache": false,
      "dependsOn": ["//#test:root", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/testing/index.ts"],
      "outputs": ["coverage/**"]
    },
    "abort": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["NODE_EXTRA_CA_CERTS"],
      "env": ["AKSARA_PUBLICATION_ENDPOINT", "AKSARA_PUBLICATION_TOKEN"]
    },
    "accept": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["NODE_EXTRA_CA_CERTS"],
      "env": ["AKSARA_PUBLICATION_ENDPOINT", "AKSARA_PUBLICATION_TOKEN"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["NAKAFA_APP_DIR"]
    },
    "clean": {
      "dependsOn": ["//#clean:root"],
      "cache": false
    },
    "cleanup": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["NODE_EXTRA_CA_CERTS"],
      "env": ["AKSARA_PUBLICATION_ENDPOINT", "AKSARA_PUBLICATION_TOKEN"]
    },
    "dev": {
      "cache": false,
      "env": ["NAKAFA_APP_DIR"],
      "persistent": true
    },
    "parity": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["NODE_EXTRA_CA_CERTS"],
      "env": [
        "AKSARA_DEV_PUBLICATION_ENDPOINT",
        "AKSARA_DEV_PUBLICATION_TOKEN",
        "AKSARA_PUBLICATION_ENDPOINT",
        "AKSARA_PUBLICATION_TOKEN"
      ]
    },
    "recover": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["NODE_EXTRA_CA_CERTS"],
      "env": [
        "AKSARA_CACHE_SURFACE",
        "AKSARA_PUBLICATION_ENDPOINT",
        "AKSARA_PUBLICATION_TOKEN",
        "AKSARA_RENDERER_ENDPOINT",
        "AKSARA_RENDERER_TOKEN"
      ]
    },
    "release": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["NODE_EXTRA_CA_CERTS"],
      "env": [
        "AKSARA_CACHE_SURFACE",
        "AKSARA_PUBLICATION_ENDPOINT",
        "AKSARA_PUBLICATION_TOKEN",
        "AKSARA_RENDERER_ENDPOINT",
        "AKSARA_RENDERER_TOKEN",
        "AKSARA_SIGNING_KEY_ID",
        "AKSARA_SIGNING_PRIVATE_KEY"
      ]
    },
    "status": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["NODE_EXTRA_CA_CERTS"],
      "env": ["AKSARA_PUBLICATION_ENDPOINT", "AKSARA_PUBLICATION_TOKEN"]
    },
    "test": {
      "dependsOn": ["//#test:root", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/testing/index.ts"],
      "outputs": ["coverage/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["//#typecheck:root", "transit"],
      "outputs": []
    },
    "verify:consumer": {
      "cache": false
    }
  }
}
