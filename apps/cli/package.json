{
  "name": "@nakafa/aksara-cli",
  "version": "0.1.4",
  "private": true,
  "description": "Official command-line interface for Aksara content authoring and publication.",
  "keywords": [
    "nakafa",
    "aksara",
    "education",
    "content",
    "publishing"
  ],
  "homepage": "https://github.com/nakafaai/aksara#readme",
  "bugs": {
    "url": "https://github.com/nakafaai/aksara/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakafaai/aksara.git",
    "directory": "apps/cli"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "imports": {
    "#cli/*": "./src/*.ts",
    "#scripts/*": "./scripts/*.ts",
    "#test/*": "./test/*.ts"
  },
  "bin": {
    "aksara": "dist/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "abort": "node --conditions=aksara-source src/main.ts abort",
    "accept": "node --conditions=aksara-source src/main.ts accept",
    "acceptance": "node --conditions=aksara-source src/acceptance/main.ts",
    "build": "node scripts/build.ts",
    "check": "node --conditions=aksara-source src/main.ts check",
    "clean": "git clean -xdf dist coverage",
    "cleanup": "node --conditions=aksara-source src/main.ts cleanup",
    "dev": "node --conditions=aksara-source src/main.ts",
    "prepack": "pnpm build",
    "recover": "node --conditions=aksara-source src/main.ts recover",
    "release": "node --conditions=aksara-source src/main.ts release",
    "status": "node --conditions=aksara-source src/main.ts status",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@nakafa/aksara-compiler": "workspace:*",
    "@nakafa/aksara-contracts": "workspace:*",
    "@nakafa/aksara-corpus": "workspace:*",
    "@nakafa/aksara-publisher": "workspace:*",
    "@nakafa/aksara-utilities": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@nakafa/testing": "workspace:*",
    "@nakafa/typescript-config": "workspace:*",
    "@vitest/coverage-istanbul": "catalog:",
    "esbuild": "0.28.2",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
