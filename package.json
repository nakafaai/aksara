{
  "name": "aksara",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "imports": {
    "#nakafa-content/*": "./.agents/skills/nakafa-content/scripts/*.ts",
    "#scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "abort": "turbo run abort --filter=@nakafa/aksara-cli",
    "accept": "turbo run accept --filter=@nakafa/aksara-cli",
    "boundaries": "node --conditions=aksara-source scripts/imports/check.ts",
    "build": "turbo run build",
    "bump-deps": "node scripts/dependencies/bump.ts",
    "check": "turbo run check --filter=@nakafa/aksara-cli",
    "clean": "turbo run clean",
    "clean:root": "git clean -xdf coverage",
    "cleanup": "turbo run cleanup --filter=@nakafa/aksara-cli",
    "deprecations": "turbo run build && pnpm deprecations:audit",
    "deprecations:audit": "node --conditions=aksara-source scripts/check/deprecations.ts",
    "dev": "turbo run dev --filter=@nakafa/aksara-cli",
    "effect:source:check": "node scripts/effect/source.ts check",
    "effect:source:update": "node scripts/effect/source.ts update",
    "format": "ultracite fix",
    "jsdocs": "node --conditions=aksara-source scripts/check/docs.ts",
    "lines": "node --conditions=aksara-source scripts/check/lines.ts",
    "lint": "pnpm effect:source:check && node --conditions=aksara-source scripts/check/effect.ts && ultracite check",
    "locales": "node --conditions=aksara-source scripts/check/locales.ts",
    "names": "node scripts/check/paths.ts",
    "parity": "turbo run parity --filter=@nakafa/aksara-cli",
    "prepare": "effect-tsgo patch",
    "quran:source:sync": "node --conditions=aksara-source scripts/quran/sync.ts",
    "recover": "turbo run recover --filter=@nakafa/aksara-cli",
    "release": "turbo run release --filter=@nakafa/aksara-cli",
    "security:audit": "node scripts/osv.ts",
    "status": "turbo run status --filter=@nakafa/aksara-cli",
    "test": "turbo run test --concurrency=1",
    "test:lesson-voice": "vitest run --config scripts/voice.config.ts",
    "test:root": "vitest run --config scripts/vitest.config.ts",
    "typecheck": "turbo run typecheck",
    "typecheck:root": "tsc --project tsconfig.json",
    "verify:consumer": "turbo run verify:consumer",
    "workflows": "node scripts/workflow/check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "catalog:",
    "@mdx-js/mdx": "catalog:",
    "@nakafa/aksara-contracts": "workspace:*",
    "@nakafa/aksara-corpus": "workspace:*",
    "@nakafa/aksara-publisher": "workspace:*",
    "@nakafa/aksara-utilities": "workspace:*",
    "@nakafa/testing": "workspace:*",
    "@sigstore/bundle": "5.0.0",
    "@types/mdast": "catalog:",
    "@types/node": "24.13.6",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "esbuild": "0.28.2",
    "remark-gfm": "catalog:",
    "remark-parse": "11.0.0",
    "sigstore": "5.0.0",
    "turbo": "2.11.2",
    "typescript": "catalog:",
    "ultracite": "7.12.0",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
