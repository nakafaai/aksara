{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "repos/**"
  ],
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            "includePackageJsonAutoImports": "on"
          },
          "tsserver": {
            "maxTsServerMemory": 8192
          }
        }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["vtsls", "!typescript-language-server", "..."]
    },
    "TypeScript": {
      "language_servers": ["vtsls", "!typescript-language-server", "..."]
    }
  }
}
